.page { padding: 20rpx 24rpx 40rpx; }

/* 起局条件 */
.cond {
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, .05);
  border: 1rpx solid rgba(147, 112, 219, .25);
  margin-bottom: 18rpx;
}

.cond-row { display: flex; align-items: center; }

.cond-label { width: 80rpx; font-size: 24rpx; color: #9f8ac0; }

.picker { flex: 1; margin-right: 14rpx; }

/* DF-60/DF-82：年/月/日/时（含分）四格一排，窄屏（320）也不换行 */
.cond-row4 { flex-wrap: nowrap; }
.picker.p4 { flex: 1 1 0; min-width: 0; margin-right: 8rpx; }

.pick-val {
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #e8dff5;
  background: rgba(147, 112, 219, .14);
  border: 1rpx solid rgba(147, 112, 219, .3);
}

.picker.p4 .pick-val { font-size: 24rpx; padding: 0 4rpx; overflow: hidden; white-space: nowrap; }
.pick-u { font-size: 20rpx; color: #9f8ac0; margin-left: 2rpx; }

/* DF-61：「此刻」改为时间行内图标按钮（可见 56×68rpx，热区 ≥88×88rpx） */
.now-btn { flex: 0 0 auto; padding: 16rpx; margin: -16rpx; }
.now-btn-inner {
  width: 56rpx;
  height: 68rpx;
  border-radius: 14rpx;
  background: rgba(147, 112, 219, .14);
  border: 1rpx solid rgba(147, 112, 219, .3);
  display: flex;
  align-items: center;
  justify-content: center;
}
.now-ico { width: 44rpx; height: 44rpx; display: block; }
.now-btn-press .now-btn-inner { background: rgba(147, 112, 219, .28); }

/* DF-85：档案栏样式（.arch-*）已上移 app.wxss 全局共用（限 .arch-bar 作用域），此处不再保留副本 */

/* 起局信息 */
.qinfo {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(147, 112, 219, .10);
  border: 1rpx solid rgba(147, 112, 219, .25);
  margin-bottom: 18rpx;
}

.qinfo-row { display: flex; align-items: center; flex-wrap: wrap; margin-bottom: 8rpx; }
.qinfo-row:last-child { margin-bottom: 0; }

.qinfo-label { font-size: 22rpx; color: #9f8ac0; margin-right: 10rpx; }

.qinfo-val { font-size: 24rpx; color: #e3d9f0; margin-right: 14rpx; }

.badge {
  font-size: 20rpx;
  color: #e8b84a;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(232, 184, 74, .12);
  border: 1rpx solid rgba(232, 184, 74, .3);
}

.badge-ju { color: #ff8fb5; background: rgba(255, 143, 181, .12); border-color: rgba(255, 143, 181, .3); }

/* DF-61：信息栏右侧「关联 / 取消 / 提示词」按钮（关联/取消两态互斥、同宽同高） */
.qinfo-btns { display: flex; margin-left: auto; }
.qinfo-btn {
  min-width: 96rpx;
  height: 44rpx;
  padding: 0 20rpx;
  margin-left: 10rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #cbb6ee;
  border-radius: 8rpx;
  border: 1rpx solid rgba(147, 112, 219, .5);
  background: rgba(147, 112, 219, .12);
}
.qinfo-btn-cancel { color: #d8b0b0; border-color: rgba(220, 120, 120, .45); }

/* 九宫格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(180, 140, 220, .25);
}

.cell {
  width: 33.333%;
  height: 240rpx;
  padding: 8rpx 10rpx;
  border-right: 1rpx solid rgba(180, 140, 220, .2);
  border-bottom: 1rpx solid rgba(180, 140, 220, .2);
  position: relative;
  background: rgba(28, 16, 50, .78);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  font-size: 21rpx;
  line-height: 1.25;
}

.c-mu { background: rgba(58, 122, 58, .25); }
.c-huo { background: rgba(192, 57, 43, .25); }
.c-tu { background: rgba(184, 134, 11, .25); }
.c-jin { background: rgba(220, 215, 235, .5); }
.c-shui { background: rgba(42, 90, 138, .25); }

.cell:nth-child(3n) { border-right: none; }
.cell:nth-child(n+7) { border-bottom: none; }

/* 值符/值使/时干 落宫高亮边框（对齐网站 .qm-cell.hl-*） */
.cell.hl-zf { box-shadow: inset 0 0 0 6rpx #b8860b; }
.cell.hl-zs { box-shadow: inset 0 0 0 6rpx #3a7a3a; }
.cell.hl-hg { box-shadow: inset 0 0 0 6rpx #2a5a8a; }
.cell.hl-zf.hl-zs { box-shadow: inset 0 0 0 6rpx #b8860b, inset 0 0 0 14rpx #3a7a3a; }
.cell.hl-zf.hl-hg { box-shadow: inset 0 0 0 6rpx #b8860b, inset 0 0 0 14rpx #2a5a8a; }
.cell.hl-zs.hl-hg { box-shadow: inset 0 0 0 6rpx #3a7a3a, inset 0 0 0 14rpx #2a5a8a; }
.cell.hl-zf.hl-zs.hl-hg { box-shadow: inset 0 0 0 6rpx #b8860b, inset 0 0 0 14rpx #3a7a3a, inset 0 0 0 22rpx #2a5a8a; }

/* 中五宫 */
.cell.center {
  background: rgba(80, 60, 120, .25);
  border-style: dashed;
  border-color: rgba(180, 140, 220, .35);
  align-items: center;
  justify-content: center;
}

.center-txt { font-size: 24rpx; color: #8a75b0; text-align: center; font-weight: 600; }
.center-tag { font-size: 18rpx; color: #b8860b; text-align: center; margin-top: 6rpx; }

/* 值符/值使/时干 角标 */
.hlbadges {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 4rpx;
  z-index: 2;
}

.hb {
  font-size: 18rpx;
  line-height: 1.4;
  padding: 0 10rpx;
  border-radius: 14rpx;
  color: #fff;
  letter-spacing: .5px;
  white-space: nowrap;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, .4);
  font-weight: 600;
}

.hb.zf { background: #b8860b; }
.hb.zs { background: #3a7a3a; }
.hb.hg { background: #2a5a8a; }

/* 每宫内容：天盘干 + 八神 + 九星（各层独立配色，对齐网站分层） */
.top { display: flex; justify-content: space-between; gap: 4rpx; font-size: 20rpx; color: #a090c0; flex-shrink: 0; white-space: nowrap; }
.top .tg { color: #e8b84a; font-weight: 700; }   /* 天盘干：金 */
.top .shen { color: #c9a0ff; }                    /* 八神：紫 */
.top .xing { color: #7fd0c0; }                    /* 九星：青 */

/* 八门（大字居中） */
.mid {
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #ff9d7a;                                  /* 八门：赤 */
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 格局标记（空/马/墓/库等）徽标 */
.flags { text-align: center; min-height: 22rpx; flex-shrink: 0; }
.flag-badge {
  display: inline-block;
  font-size: 18rpx;
  line-height: 1.4;
  padding: 0 10rpx;
  border-radius: 14rpx;
  color: #ffb3c0;
  background: rgba(208, 96, 112, .22);
  font-weight: 600;
  white-space: nowrap;
}

/* 地盘干 + 宫位 */
.bot { display: flex; justify-content: space-between; gap: 4rpx; flex-shrink: 0; font-size: 20rpx; margin-top: auto; }
.bot .di { color: #8fa8e0; font-weight: 500; }   /* 地盘干：蓝 */
.bot .gn { color: #6a5a85; font-weight: 500; }

.tip { font-size: 22rpx; color: #8f7cb0; margin: 16rpx 0 10rpx; }

.empty { padding: 100rpx 20rpx; text-align: center; font-size: 26rpx; color: #8f7cb0; }

/* 详情弹层 */
.d-row { display: flex; flex-direction: column; padding: 16rpx 0; border-bottom: 1rpx solid rgba(147, 112, 219, .16); }
.d-k { font-size: 26rpx; color: #e8b84a; margin-bottom: 4rpx; }
.d-v { font-size: 30rpx; color: #efe6ff; line-height: 1.5; margin-bottom: 4rpx; }
.d-d { font-size: 28rpx; color: #a692c4; line-height: 1.7; white-space: pre-wrap; }

.hint-scroll { max-height: 56vh; margin-bottom: 14rpx; }

.hint-text { font-size: 24rpx; color: #c9bce2; line-height: 1.72; white-space: pre-wrap; }

/* 全屏页内容区（宫位详情 / 提示词预览） */
.qm-fs-body { padding: 24rpx 32rpx; }

/* DF-59：宫位详情层作用域（.qm-detail-page），不影响 chat 等其它全屏层 */
/* 标题字号放大一档：34rpx（覆写全局 .fs-title 30rpx，禁改 app.wxss 基准） */
.qm-detail-page .fs-title { font-size: 34rpx; }
/* 返回热区由 56rpx 扩至 88rpx：padding 由负 margin 抵消占位，视觉圆径保持 56rpx */
.qm-detail-page .fs-back {
  width: 88rpx;
  height: 88rpx;
  margin: -16rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, .1) 0 27rpx, rgba(255, 255, 255, 0) 28rpx);
}
.qm-detail-page .fs-back-press {
  background: radial-gradient(circle, rgba(255, 255, 255, .2) 0 27rpx, rgba(255, 255, 255, 0) 28rpx);
}
/* 详情主体底部安全区留白（原底部按钮区已移除，避免 Home 指示条遮挡末行） */
.qm-detail-page .qm-fs-body { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
