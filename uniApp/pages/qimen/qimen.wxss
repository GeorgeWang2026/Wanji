.page { padding: 20rpx 24rpx 40rpx; }

/* 起局条件 */
.cond {
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, .05);
  border: 1rpx solid rgba(147, 112, 219, .25);
  margin-bottom: 18rpx;
}

.cond-row { display: flex; align-items: center; }

.cond-label { width: 80rpx; font-size: 24rpx; color: #9f8ac0; }

.picker { flex: 1; margin-right: 14rpx; }

.pick-val {
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #e8dff5;
  background: rgba(147, 112, 219, .14);
  border: 1rpx solid rgba(147, 112, 219, .3);
}

.cond-actions { display: flex; justify-content: flex-end; margin-top: 16rpx; }

.cond-actions .qm-btn { width: 180rpx; height: 66rpx; margin-left: 16rpx; }

/* 起局信息 */
.qinfo {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(147, 112, 219, .10);
  border: 1rpx solid rgba(147, 112, 219, .25);
  margin-bottom: 18rpx;
}

.qinfo-row { display: flex; align-items: center; flex-wrap: wrap; margin-bottom: 8rpx; }
.qinfo-row:last-child { margin-bottom: 0; }

.qinfo-label { font-size: 22rpx; color: #9f8ac0; margin-right: 10rpx; }

.qinfo-val { font-size: 24rpx; color: #e3d9f0; margin-right: 14rpx; }

.badge {
  font-size: 20rpx;
  color: #e8b84a;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(232, 184, 74, .12);
  border: 1rpx solid rgba(232, 184, 74, .3);
}

.badge-ju { color: #ff8fb5; background: rgba(255, 143, 181, .12); border-color: rgba(255, 143, 181, .3); }

/* 九宫格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(147, 112, 219, .3);
}

.cell {
  width: 33.333%;
  height: 250rpx;
  padding: 10rpx 8rpx;
  border-right: 1rpx solid rgba(147, 112, 219, .2);
  border-bottom: 1rpx solid rgba(147, 112, 219, .2);
  position: relative;
  background: rgba(28, 16, 50, .78);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.c-mu { background: rgba(42, 90, 60, .30); }
.c-huo { background: rgba(140, 45, 45, .28); }
.c-tu { background: rgba(140, 105, 30, .26); }
.c-jin { background: rgba(90, 90, 110, .26); }
.c-shui { background: rgba(35, 70, 120, .30); }

.cell:nth-child(3n) { border-right: none; }
.cell:nth-child(n+7) { border-bottom: none; }

.center-txt { font-size: 30rpx; color: #cdbce8; text-align: center; margin-top: 60rpx; }
.center-sub { font-size: 22rpx; color: #8f7cb0; text-align: center; }
.center-tag { font-size: 20rpx; color: #e8b84a; text-align: center; }

.badges { display: flex; flex-wrap: wrap; min-height: 28rpx; }

.hb {
  font-size: 18rpx;
  padding: 0 8rpx;
  margin-right: 6rpx;
  border-radius: 6rpx;
  color: #1a0f2e;
  background: #e8b84a;
}

.hb-zf { background: #f0d48a; }
.hb-zs { background: #ff8fb5; }
.hb-hg { background: #8fb5ff; }

.row-top { display: flex; align-items: baseline; justify-content: space-between; }

.tg { font-size: 42rpx; font-weight: 700; line-height: 1.1; }

.shen { font-size: 20rpx; color: #e8b84a; }

.row-mid { display: flex; align-items: center; justify-content: space-between; }

.xing { font-size: 26rpx; color: #d7c9ef; }

.men { font-size: 26rpx; color: #ff8fb5; font-weight: 600; }

.row-bot { display: flex; align-items: center; justify-content: space-between; }

.dg { font-size: 26rpx; font-weight: 600; }

.gname { font-size: 20rpx; color: #8f7cb0; }

.flags { display: flex; flex-wrap: wrap; min-height: 24rpx; }

.flag {
  font-size: 18rpx;
  color: #b9a8d6;
  margin-right: 6rpx;
  padding: 0 6rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, .07);
}

.tip { font-size: 22rpx; color: #8f7cb0; margin: 16rpx 0 10rpx; }

.actions { display: flex; margin-top: 14rpx; }

.actions .qm-btn { flex: 1; margin-right: 16rpx; }
.actions .qm-btn:last-child { margin-right: 0; }

.empty { padding: 100rpx 20rpx; text-align: center; font-size: 26rpx; color: #8f7cb0; }

/* 详情弹层 */
.d-row { display: flex; flex-direction: column; padding: 12rpx 0; border-bottom: 1rpx solid rgba(147, 112, 219, .16); }
.d-k { font-size: 22rpx; color: #e8b84a; margin-bottom: 4rpx; }
.d-v { font-size: 26rpx; color: #efe6ff; margin-bottom: 4rpx; }
.d-d { font-size: 24rpx; color: #a692c4; line-height: 1.7; white-space: pre-wrap; }

.hint-scroll { max-height: 56vh; margin-bottom: 14rpx; }

.hint-text { font-size: 24rpx; color: #c9bce2; line-height: 1.72; white-space: pre-wrap; }

/* 全屏页内容区（宫位详情 / 提示词预览） */
.qm-fs-body { padding: 24rpx 32rpx; }
