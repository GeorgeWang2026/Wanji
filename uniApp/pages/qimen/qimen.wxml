<!-- ============================================================
     奇门遁甲排盘（对应 xiaoxuan.html 的 paipanModal「奇门遁甲」页签）
     转盘九宫格用 flex 布局还原，点击宫位看释义
     ============================================================ -->
<view class="page">

  <!-- 起局条件：年/月/日/时 四输入一排，改动即自动排盘（DF-60） -->
  <view class="cond">
    <view class="cond-row cond-row4">
      <picker class="picker p4" mode="selector" range="{{years}}" value="{{yearIdx}}" bindchange="onYearChange">
        <view class="pick-val">{{years[yearIdx]}}<text class="pick-u">年</text></view>
      </picker>
      <picker class="picker p4" mode="selector" range="{{months}}" value="{{monthIdx}}" bindchange="onMonthChange">
        <view class="pick-val">{{months[monthIdx]}}<text class="pick-u">月</text></view>
      </picker>
      <picker class="picker p4" mode="selector" range="{{days}}" value="{{dayIdx}}" bindchange="onDayChange">
        <view class="pick-val">{{days[dayIdx]}}<text class="pick-u">日</text></view>
      </picker>
      <picker class="picker p4" mode="selector" range="{{hours}}" value="{{hourIdx}}" bindchange="onHourChange">
        <view class="pick-val">{{hours[hourIdx]}}<text class="pick-u">时</text></view>
      </picker>
    </view>
    <view class="cond-actions">
      <view class="qm-btn qm-btn-ghost" bindtap="useNow">此刻</view>
    </view>
  </view>

  <!-- DF-61：档案栏（九宫格上方）；无档案时居中「去创建」 -->
  <view class="arch-bar">
    <scroll-view wx:if="{{archives.length}}" class="arch-scroll" scroll-x>
      <view
        class="arch-chip {{item.id === activeArchiveId ? 'on' : ''}}"
        wx:for="{{archives}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onArchiveTap"
      >
        <view class="arch-nick">{{item.nickname}}</view>
        <view class="arch-sub">{{item.sub}}</view>
      </view>
    </scroll-view>
    <view class="arch-empty" wx:else>
      <view class="qm-btn qm-btn-primary" bindtap="onGoCreate">去创建</view>
    </view>
  </view>

  <block wx:if="{{built}}">
    <!-- 起局信息 -->
    <view class="qinfo">
      <view class="qinfo-row">
        <text class="qinfo-label">四柱</text>
        <text class="qinfo-val">{{info.bazi}}</text>
        <text class="badge">{{info.jieqi}}</text>
      </view>
      <view class="qinfo-row">
        <text class="qinfo-label">定局</text>
        <text class="qinfo-val">{{info.yuan}} · {{info.dun}}</text>
        <text class="badge badge-ju">{{info.ju}} 局</text>
        <view class="qinfo-btns">
          <view class="qinfo-btn {{bound ? 'off' : ''}}" bindtap="onBind">关联</view>
          <view class="qinfo-btn {{bound ? '' : 'off'}}" bindtap="onUnbind">取消</view>
          <view class="qinfo-btn" bindtap="previewPrompt">提示词</view>
        </view>
      </view>
      <view class="qinfo-row">
        <text class="qinfo-label">值符</text>
        <text class="qinfo-val">{{info.zf}}</text>
        <text class="qinfo-label">值使</text>
        <text class="qinfo-val">{{info.zs}}</text>
      </view>
    </view>

    <!-- 九宫格 -->
    <view class="grid">
      <view
        class="cell {{item.cls}}"
        wx:for="{{cells}}"
        wx:key="g"
        bindtap="onCellTap"
        data-index="{{index}}"
      >
        <block wx:if="{{item.g === 5}}">
          <view class="center-txt">中五 · 寄坤</view>
          <view class="center-tag" wx:if="{{item.centerTag}}">{{item.centerTag}}</view>
        </block>
        <block wx:else>
          <view class="hlbadges">
            <text class="hb {{b.cls}}" wx:for="{{item.badges}}" wx:for-item="b" wx:key="t">{{b.t}}</text>
          </view>
          <view class="top">
            <text class="tg">{{item.tg}}</text>
            <text class="shen">{{item.shen}}</text>
            <text class="xing">{{item.xing}}</text>
          </view>
          <view class="mid">{{item.men}}</view>
          <view class="flags" wx:if="{{item.flagsText}}"><text class="flag-badge">{{item.flagsText}}</text></view>
          <view class="bot">
            <text class="di">{{item.dg}}</text>
            <text class="gn">{{item.gname}}</text>
          </view>
        </block>
      </view>
    </view>

    <view class="tip">点击任一宫位，查看该宫八神 / 九星 / 八门 / 天盘干的释义</view>
  </block>

  <view class="empty" wx:else>
    <text>调整年 / 月 / 日 / 时后将自动排出奇门九宫盘。</text>
  </view>

  <!-- 宫位详情：全屏页面形态（左返回 + 居中标题，无 ✕） -->
  <view class="fs-page qm-detail-page" wx:if="{{detail}}">
    <view class="fs-header">
      <view class="fs-back" hover-class="fs-back-press" catchtap="closeDetail">
        <text class="fs-back-ico">‹</text>
      </view>
      <text class="fs-title">{{detail.title}}</text>
    </view>
    <scroll-view scroll-y class="fs-body qm-fs-body">
      <view class="d-row" wx:for="{{detail.rows}}" wx:key="k">
        <text class="d-k">{{item.k}}</text>
        <text class="d-v">{{item.v}}</text>
        <text class="d-d">{{item.d}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 提示词预览：全屏页面形态（左返回 + 居中标题，无 ✕） -->
  <view class="fs-page" wx:if="{{showHint}}">
    <view class="fs-header">
      <view class="fs-back" hover-class="fs-back-press" catchtap="closeHint">
        <text class="fs-back-ico">‹</text>
      </view>
      <text class="fs-title">后端将使用的盘面提示词</text>
    </view>
    <scroll-view scroll-y class="fs-body qm-fs-body">
      <text class="hint-text">{{hint}}</text>
    </scroll-view>
  </view>
</view>
