<!-- ============================================================
     首页：对话主流程（视觉结构对齐 xiaoxuan.html）
     - 顶部「您的咨询」折叠面板
     - 中部头像舞台（光环 / 脉冲 / 排盘圆钮）
     - 底部输入面板（可折叠）+ 控制区（记录 / 麦克风 / 账号）
     - 咨询记录弹层（参考页 #chatHistoryModal）
     - 个人中心弹层（参考页 #profileModal）
     - 登录/注册底部弹层（参考页 #authMask）
     - 积分消耗确认卡片（参考页自绘对话框）
     ============================================================ -->
<view class="app" style="padding-top:{{statusBarH}}px;">

  <!-- ============ 顶部：您的咨询 ============ -->
  <view class="panel-top">
    <view class="panel-header" bindtap="toggleTop">
      <!-- 原右侧「⟳ 重新开始」文字按钮 → 左侧圆形按钮（同一点击逻辑 onRestart，热区仍是 56rpx 圆） -->
      <view class="ph-icon" hover-class="ph-icon-press" catchtap="onRestart">⟳</view>
      <!-- 标题绝对居中；折叠三角紧贴标题左侧，不再占最右位置 -->
      <view class="p-head">
        <view class="p-arrow {{topOpen ? 'open' : ''}}">▼</view>
        <text class="p-title">万机决策助手</text>
      </view>
    </view>

    <view class="panel-body {{topOpen ? 'open' : ''}}">
      <!-- 未提交问题时的默认提示（对应参考页 #pcEmptyHint）；DF-64：空闲期在此轮播金句 -->
      <view class="pc-empty-hint" id="pcEmptyHint" wx:if="{{!pinned && !sentVisible}}">
        <block wx:if="{{idleQuote}}">
          <text class="idle-quote-text">{{idleQuote.text}}</text>
          <text class="idle-quote-author">—— {{idleQuote.author}}</text>
          <text class="idle-quote-translation" wx:if="{{idleQuote.translation}}">译文：{{idleQuote.translation}}</text>
        </block>
        <block wx:else>请先在下方用语音或文字输入你想咨询的问题</block>
      </view>

      <!-- 置顶上下文（对应参考页 #pinnedContext）：_renderChatRoot 平铺后的结构
           header(您的问题 + 时间 + 查看咨询报告) → 技能标签 → 问题正文 → 追问列表 -->
      <view class="pinned-context" id="pinnedContext" wx:if="{{pinned}}">
        <view class="chat-item-header">
          <text class="mode-badge">您的问题</text>
          <text class="pc-time">{{pinned.timeText}}</text>
          <view class="mode-badge pc-report" hover-class="pc-report-press"
                wx:if="{{pinned.feishuUrl}}" catchtap="onPinnedFeishu">查看咨询报告</view>
        </view>

        <!-- boundTags：有置顶内容时移动到 header 之后（参考页 insertAdjacentElement('afterend')） -->
        <view class="bound-tags" id="boundTags" wx:if="{{chips.length > 0}}">
          <view class="bound-tag {{item.cls}}" wx:for="{{chips}}" wx:key="type"
                hover-class="bound-tag-press" catchtap="onChipTap" data-type="{{item.type}}">
            <text class="bt-icon">{{item.icon}}</text>
            <text class="bt-detail" wx:if="{{item.detail}}">{{item.detail}}</text>
            <text class="bt-close" catchtap="onChipClose" data-type="{{item.type}}">×</text>
          </view>
        </view>

        <view class="chat-item-question" wx:if="{{pinned.question}}"
              catchtap="onPinnedQuestionTap" catchlongpress="onPinnedQuestionLongPress">{{pinned.question}}</view>

        <view class="chat-item-followups" wx:if="{{pinned.followups.length > 0}}">
          <view class="chat-item-followup" wx:for="{{pinned.followups}}" wx:for-item="fu" wx:key="id"
                catchtap="onFollowupTap" catchlongpress="onFollowupLongPress" data-idx="{{index}}">
            <text class="cif-tag">追问</text>{{fu.text}}
          </view>
        </view>
      </view>

      <!-- 已提交问题（扣积分确认后）置顶展示（对应参考页 #sentPreview） -->
      <view class="sent-preview" id="sentPreview" wx:if="{{sentVisible}}">
        <view class="sent-badge">✓ 已发送</view>
        <text class="sent-badge sent-feishu-badge" id="sentFeishuBadge"
              wx:if="{{sentFeishuUrl}}" catchtap="onSentFeishu">📄 查看咨询报告 ↗</text>
        <view class="sent-content" id="sentContent">{{sentContent}}</view>
      </view>

      <!-- 语音字幕区（对应参考页 #ttsLines / #ttsBody） -->
      <view class="tts-lines" id="ttsLines" wx:if="{{typing || ttsText}}">
        <view class="tts-body" id="ttsBody">
          <view class="thinking-marquee" wx:if="{{typing}}">
            <block wx:if="{{hintQuote}}">
              <text class="quote-text">{{hintQuote.text}}</text>
              <text class="quote-author">—— {{hintQuote.author}}</text>
              <text class="quote-translation" wx:if="{{hintQuote.translation}}">译文：{{hintQuote.translation}}</text>
            </block>
            <block wx:else><text class="dot-flash">●</text> {{typingText}}</block>
          </view>
          <block wx:else>
            <text class="sr-label">{{ttsLabel}}</text>
            <text class="sr-text">{{ttsText}}</text>
            <text class="placeholder" wx:if="{{!ttsText}}">播报内容将在这里显示…</text>
          </block>
        </view>
        <!-- 保留项：参考页无此控件，小程序用它暂停/恢复播报、长按关闭自动播报 -->
        <view class="tts-vol {{ttsOn ? (speaking ? 'on' : '') : 'muted'}}"
              hover-class="press-zone" catchtap="onTtsIcon" catchlongpress="onTtsOff">
          <text class="tts-vol-ico">{{ttsOn ? (speaking ? '🔊' : '🔉') : '🔇'}}</text>
        </view>
      </view>

      <!-- 无置顶内容时，绑定标签仍留在面板底部（参考页 #boundTags 的静态位置） -->
      <view class="bound-tags" wx:if="{{!pinned && chips.length > 0}}">
        <view class="bound-tag {{item.cls}}" wx:for="{{chips}}" wx:key="type"
              hover-class="bound-tag-press" catchtap="onChipTap" data-type="{{item.type}}">
          <text class="bt-icon">{{item.icon}}</text>
          <text class="bt-detail" wx:if="{{item.detail}}">{{item.detail}}</text>
          <text class="bt-close" catchtap="onChipClose" data-type="{{item.type}}">×</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ============ 中部：头像舞台 ============ -->
  <view class="stage">
    <view class="status-tag {{(recording || typing || speaking) && !topOpen ? 'show' : ''}}">{{recording ? '正在聆听…' : (typing ? typingText : (speaking ? '正在播报…' : ''))}}</view>

    <view class="avatar-wrap {{recording ? 'is-listening' : ''}}">
      <view class="pulse-ring {{recording ? 'active' : ''}}"></view>
      <view class="avatar-ring {{(recording || typing || speaking) ? '' : 'idle'}}"></view>

      <view class="avatar-stage" bindtap="onAvatarTap">
        <image
          wx:if="{{!avatarErr}}"
          class="avatar-img"
          src="{{avatarSrc}}"
          mode="aspectFill"
          binderror="onAvatarErr"
        />
        <view wx:else class="avatar-fallback">
          <text class="fallback-txt">玄</text>
        </view>
        <view
          wx:if="{{mouthRect}}"
          class="mouth-overlay {{speaking ? 'on' : ''}}"
          style="left:{{mouthRect.left}}%;top:{{mouthRect.top}}%;width:{{mouthRect.width}}%;height:{{mouthRect.height}}%;"
        >
          <image class="mouth-img" src="/uniApp/static/mouth.png" mode="aspectFit" style="transform:scale({{mouthSx}},{{mouthSy}});" />
        </view>
      </view>

      <!-- DF-62：使用用户头像时隐藏角色左右切换（避免"头像顶点/切换角色"歧义） -->
      <view class="avatar-nav prev" wx:if="{{!usingUserAvatar}}" hover-class="press-zone" catchtap="prevAvatar">‹</view>
      <view class="avatar-nav next" wx:if="{{!usingUserAvatar}}" hover-class="press-zone" catchtap="nextAvatar">›</view>
    </view>

    <view class="paipan-bar">
      <view class="paipan-btn {{skillActive.qimen ? 'active' : ''}}" hover-class="press-zone" bindtap="openPaipan" data-type="qimen">
        <text class="p-icon">☯</text>
        <text class="p-label">奇门</text>
      </view>
      <view class="paipan-btn {{skillActive.bazi ? 'active' : ''}}" hover-class="press-zone" bindtap="openPaipan" data-type="bazi">
        <text class="p-icon">命</text>
        <text class="p-label">八字</text>
      </view>
      <view class="paipan-btn {{skillActive.meihua ? 'active' : ''}}" hover-class="press-zone" bindtap="openPaipan" data-type="meihua">
        <text class="p-icon">☰</text>
        <text class="p-label">梅花</text>
      </view>
      <view class="paipan-btn" hover-class="press-zone" bindtap="openPaipan" data-type="stock">
        <text class="p-icon">📈</text>
        <text class="p-label">证券</text>
      </view>
    </view>
  </view>

  <!-- ============ 底部：输入面板 ============ -->
  <view class="panel-bot {{inputOpen ? 'open' : ''}}">
    <view class="panel-header" bindtap="toggleInput">
      <view class="ph-icon">⌨️</view>
      <text class="p-title">输入问题</text>
      <text class="p-sub" wx:if="{{!inputOpen}}">点此展开文字提问</text>
      <view class="p-arrow {{inputOpen ? 'open' : ''}}">▼</view>
    </view>

    <!-- 展开态：向上浮在标题之上，覆盖头像/技能按钮区；catchtap 阻止点击穿透 -->
    <view class="panel-body" wx:if="{{inputOpen}}" catchtap="noop">
      <view class="quick-qas">
        <view class="quick-qa" wx:for="{{examples}}" wx:key="*this" bindtap="onExample" data-text="{{item}}">{{item}}</view>
      </view>

      <view class="input-row">
        <view class="rec-input-wrap">
          <textarea
            class="rec-input"
            value="{{input}}"
            cursor="{{inputCursor}}"
            placeholder="{{recording ? '正在聆听…说完再点一次麦克风' : '说说你想问的事…'}}"
            placeholder-class="rec-input-ph"
            auto-height
            maxlength="1000"
            cursor-spacing="30"
            show-confirm-bar="{{false}}"
            bindinput="onInput"
            bindfocus="onInputFocus"
            bindblur="onInputBlur"
            bindconfirm="onSendTap"
          />
          <view class="rec-clear" wx:if="{{canClear && !recording}}" hover-class="press-zone" catchtap="clearInput">×</view>
        </view>
        <view class="rec-send {{sending ? 'disabled' : ''}}" hover-class="press-zone" bindtap="onSendTap">↑</view>
      </view>

      <view class="input-foot">
        <text class="rec-hint" wx:if="{{recording}}">正在聆听 {{recSeconds}}s，再点麦克风结束</text>
        <text class="rec-count" wx:elif="{{input.length >= 900}}">{{input.length}}/1000</text>
      </view>
    </view>
  </view>

  <!-- ============ 底部控制区 ============ -->
  <view class="controls">
    <view class="ctrl-btn" hover-class="ctrl-press" bindtap="openHistory">
      <image class="ctrl-ico" src="/uniApp/static/icons/chat-history.png" mode="aspectFit" />
      <!-- FB-51：咨询记录未读数字角标（原 ctrl-dot 红点升级；计数为未读回复条数，>99 显示 99+） -->
      <view wx:if="{{historyUnread > 0}}"
            style="position:absolute;top:2rpx;right:2rpx;min-width:30rpx;height:30rpx;padding:0 6rpx;box-sizing:border-box;border-radius:15rpx;background:#ff6478;color:#fff;font-size:20rpx;line-height:30rpx;text-align:center;box-shadow:0 0 8rpx rgba(255,100,120,.9);">{{historyUnread > 99 ? '99+' : historyUnread}}</view>
    </view>
    <view class="mic-btn {{recording ? 'recording' : ''}}" hover-class="mic-press" bindtap="onMicTap">
      <image class="mic-ico" src="/uniApp/static/icons/chat-mic.png" mode="aspectFit" />
    </view>
    <view class="ctrl-btn" hover-class="ctrl-press" bindtap="onAccountTap">
      <image class="ctrl-ico" src="/uniApp/static/icons/chat-account.png" mode="aspectFit" />
    </view>
  </view>

  <!-- ============ 咨询记录：全屏页面形态（左返回 + 居中标题，无 ✕） ============ -->
  <view class="fs-page" id="chatHistoryModal" wx:if="{{showHistory}}" style="padding-top:{{statusBarH}}px;">
    <view class="fs-header">
      <view class="fs-back" hover-class="press-zone" catchtap="closeHistory">
        <text class="fs-back-ico">‹</text>
      </view>
      <text class="fs-title">📜 咨询记录</text>
    </view>

      <scroll-view
        class="modal-body fs-body"
        scroll-y
        enhanced="{{true}}"
        show-scrollbar="{{false}}"
      >
        <!-- 空态 / 加载中 / 接口失败：结构与文案照抄参考页 loadChatHistory / renderChatHistory -->
        <view class="chat-empty" wx:if="{{historyLoading && historyRecords.length === 0}}">加载中…</view>
        <block wx:elif="{{historyRecords.length === 0}}">
          <view class="chat-empty" wx:if="{{historyError}}">❌ {{historyError}}</view>
          <view class="chat-empty" wx:else>还没有咨询记录，说点什么试试吧～</view>
          <view class="chat-load-more" wx:if="{{historyError}}" hover-class="chat-load-more-press" bindtap="retryHistory">点击重试</view>
        </block>

        <!-- 一条咨询 = 一张卡：层级/类名照抄参考页 _renderChatRoot -->
        <block wx:for="{{historyRecords}}" wx:key="id">
          <view class="chat-item {{item.expanded ? 'expanded' : ''}}" data-qid="{{item.id}}" hover-class="chat-item-press">
            <view class="chat-item-header" bindtap="toggleRecord" data-idx="{{index}}">
              <text class="mode-badge">{{item.modeText}}</text>
              <text>{{item.timeText}}</text>
              <text class="chat-item-name" wx:if="{{item.userName}}">{{item.userName}}</text>
              <text class="chat-item-source">{{item.sourceText}}</text>
              <!-- 参考页为 <button class="del-btn">；小程序无原生 button → view（去掉 button 默认边框/背景） -->
              <view class="del-btn" hover-class="del-btn-press" catchtap="onDeleteRecord" data-idx="{{index}}">🗑️</view>
            </view>

            <!-- 技能卡片：.chat-item-user > .chat-pan-cards > .chat-pan-tip.bound-tag -->
            <view class="chat-item-user" wx:if="{{item.skillChips.length > 0}}">
              <view class="chat-pan-cards">
                <view class="chat-pan-tip bound-tag {{chip.cls}}" wx:for="{{item.skillChips}}" wx:for-item="chip" wx:for-index="ci" wx:key="type"
                      catchtap="onSkillChipTap" data-idx="{{index}}" data-type="{{chip.type}}">
                  <text class="bt-icon">{{chip.icon}}</text>
                  <text class="bt-detail" wx:if="{{chip.label}}">{{chip.label}}</text>
                </view>
              </view>
            </view>

            <view class="chat-item-question" bindtap="toggleRecord" data-idx="{{index}}">{{item.question}}</view>

            <!-- 追问列表：参考页只有 .cif-tag + 问题文本，点击整卡折叠 -->
            <view class="chat-item-followups" wx:if="{{item.followups.length > 0}}">
              <view class="chat-item-followup" wx:for="{{item.followups}}" wx:for-item="fu" wx:key="id"
                    bindtap="toggleRecord" data-idx="{{index}}">
                <text class="cif-tag">追问</text>{{fu.text}}
              </view>
            </view>

            <!-- 报告区：.xb-feishu-btn + .xb-continue-btn 同一行各占一半 -->
            <view class="chat-item-report">
              <view class="xb-feishu-btn {{item.feishuState === 'off' ? 'xb-fs-disabled' : ''}}"
                    hover-class="{{item.feishuState === 'off' ? 'none' : 'xb-feishu-press'}}"
                    catchtap="onFeishu" data-idx="{{index}}">{{item.feishuLabel}}</view>
              <view class="xb-continue-btn" hover-class="xb-continue-press" catchtap="onContinue" data-idx="{{index}}">💬 追问</view>
            </view>

            <!-- 深度解读：默认 display:none，.chat-item.expanded 时显示（1:1 CSS 控制） -->
            <view class="chat-item-reply">
              <rich-text wx:if="{{item.replyHtml}}" nodes="{{item.replyHtml}}"></rich-text>
              <text wx:else>{{item.reply}}</text>
            </view>
          </view>
        </block>

        <!-- 分页：结构与文案照抄参考页 renderChatHistory 的 moreHtml -->
        <view class="chat-load-more" wx:if="{{historyRecords.length > 0 && historyShown < historyTotal && !historyAppendError}}"
              hover-class="chat-load-more-press" bindtap="loadMoreHistory">
          {{historyLoadingMore ? '加载中…' : '点击加载更多（还剩 ' + (historyTotal - historyShown) + ' 条）'}}
        </view>
        <view class="chat-load-more" wx:if="{{historyRecords.length > 0 && historyAppendError}}"
              hover-class="chat-load-more-press" bindtap="loadMoreHistory">加载失败，点击重试</view>
      </scroll-view>
  </view>

  <!-- ============ 技能深度解读：全屏页面形态（FB-44，复用 fs-page 结构） ============ -->
  <view class="fs-page" id="skillAnalysisModal" wx:if="{{showSkillAnalysis}}" style="padding-top:{{statusBarH}}px;">
    <view class="fs-header">
      <view class="fs-back" hover-class="press-zone" catchtap="closeSkillAnalysis">
        <text class="fs-back-ico">‹</text>
      </view>
      <text class="fs-title">{{skillAnalysisTitle || '深度解读'}}</text>
    </view>

    <scroll-view class="skill-analysis-body fs-body" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="am-empty" wx:if="{{skillAnalysisState === 'loading'}}">{{skillAnalysisMsg || '正在生成深度解读…'}}</view>
      <view class="am-empty" wx:elif="{{skillAnalysisState === 'none'}}">{{skillAnalysisMsg}}</view>
      <view class="am-empty" wx:elif="{{skillAnalysisState === 'error'}}">
        {{skillAnalysisMsg || '暂无深度解读'}}
        <view class="skill-analysis-retry" hover-class="press-zone" catchtap="onSkillAnalysisRetry">点此重试</view>
      </view>
      <rich-text wx:else nodes="{{skillAnalysisHtml}}"></rich-text>
    </scroll-view>
  </view>

  <!-- ============ 个人中心：全屏页面形态（左返回 + 居中标题，无 ✕） ============ -->
  <view class="fs-page" wx:if="{{showProfile}}" style="padding-top:{{statusBarH}}px;">
      <view class="fs-header">
        <view class="fs-back" hover-class="press-zone" catchtap="closeProfile">
          <text class="fs-back-ico">‹</text>
        </view>
        <text class="fs-title">👤 个人中心</text>
      </view>

      <scroll-view class="modal-body profile-body fs-body" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
        <!-- DF-62：头像可点选更换（open-type=chooseAvatar），昵称就地编辑 -->
        <view class="profile-hero">
          <button class="profile-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" hover-class="none">
            <image wx:if="{{profileAvatar}}" class="profile-avatar-img" src="{{profileAvatar}}" mode="aspectFill" />
            <view wx:else class="profile-avatar">✦</view>
          </button>
          <view class="profile-info">
            <block wx:if="{{!nicknameEditing}}">
              <view class="profile-name" hover-class="press-zone" bindtap="onEditNickname">{{profileName || '用户'}}<text class="profile-edit-ico">✎</text></view>
            </block>
            <block wx:else>
              <view class="nickname-edit">
                <input class="nickname-input" type="nickname" value="{{nicknameDraft}}" placeholder="请输入昵称"
                       maxlength="64" confirm-type="done" bindinput="onNicknameInput" bindconfirm="onSaveNickname" />
                <view class="nickname-btn ok" hover-class="press-zone" bindtap="onSaveNickname">确定</view>
                <view class="nickname-btn cancel" hover-class="press-zone" bindtap="onCancelNickname">取消</view>
              </view>
            </block>
            <view class="profile-sub">ID: {{userId || '-'}}</view>
          </view>
        </view>

        <view class="profile-menu">
          <view class="profile-item" hover-class="item-press" bindtap="onArchives">
            <text class="pi-icon">🗂️</text>
            <text class="pi-text">我的档案</text>
            <text class="pi-arrow">›</text>
          </view>
          <view class="profile-item" hover-class="item-press" bindtap="onProfileHistory">
            <text class="pi-icon">📜</text>
            <text class="pi-text">我的咨询记录</text>
            <text class="pi-arrow">›</text>
          </view>
          <view class="profile-item" hover-class="item-press" bindtap="onProfileCredits">
            <text class="pi-icon">💎</text>
            <text class="pi-text">我的积分</text>
            <text class="pi-arrow">›</text>
          </view>
          <view class="profile-item danger" hover-class="item-press" bindtap="logout">
            <text class="pi-icon">🚪</text>
            <text class="pi-text">退出登录</text>
            <text class="pi-arrow">›</text>
          </view>
        </view>
      </scroll-view>
  </view>

  <!-- ============ 我的档案：列表（DF-56，内嵌全屏层，不新增页面 / 不改 app.json） ============ -->
  <view class="fs-page" wx:if="{{showArchives}}" style="padding-top:{{statusBarH}}px;">
    <view class="fs-header">
      <view class="fs-back" hover-class="press-zone" catchtap="closeArchives">
        <text class="fs-back-ico">‹</text>
      </view>
      <text class="fs-title">我的档案</text>
    </view>
    <scroll-view class="fs-body" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
      <view wx:if="{{archives.length === 0 && !archivesLoading}}" class="archives-empty">暂无档案，点击下方「新增档案」</view>
      <view wx:for="{{archives}}" wx:key="id" class="arch-card" bindtap="onEditArchive" data-id="{{item.id}}">
        <view class="arch-main">
          <text class="arch-name">{{item.nickname || '未命名'}}</text>
          <text class="arch-sub">{{item.gender || '性别未填'}} · {{item.relationLabel}} · {{item.birthText}}</text>
        </view>
        <view class="arch-del" wx:if="{{!item.is_self}}" catchtap="onDeleteArchive" data-id="{{item.id}}">删除</view>
      </view>
      <view class="arch-add" hover-class="item-press" bindtap="onNewArchive">+ 新增档案</view>
    </scroll-view>
  </view>

  <!-- ============ 我的档案：新增 / 编辑（DF-56） ============ -->
  <view class="fs-page" wx:if="{{showArchiveEditor}}" style="padding-top:{{statusBarH}}px;">
    <view class="fs-header">
      <view class="fs-back" hover-class="press-zone" catchtap="closeArchiveEditor">
        <text class="fs-back-ico">‹</text>
      </view>
      <text class="fs-title">{{archEditing ? '编辑档案' : '新增档案'}}</text>
    </view>
    <scroll-view class="fs-body" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="form-row">
        <text class="form-label">昵称</text>
        <input class="form-input" placeholder="请输入昵称" placeholder-class="form-ph" value="{{archForm.nickname}}" bindinput="onArchInput" data-field="nickname" maxlength="64" />
      </view>
      <view class="form-row">
        <text class="form-label">性别</text>
        <picker mode="selector" range="{{genderOptions}}" value="{{archGenderIndex}}" bindchange="onArchGenderChange">
          <view class="form-picker">{{archGenderIndex > 0 ? genderOptions[archGenderIndex] : '请选择性别'}}</view>
        </picker>
      </view>
      <view class="form-row">
        <text class="form-label">关系</text>
        <picker mode="selector" range="{{relationLabels}}" value="{{archRelationIndex}}" bindchange="onArchRelationChange">
          <view class="form-picker">{{relationLabels[archRelationIndex]}}</view>
        </picker>
      </view>
      <view class="form-row">
        <text class="form-label">出生年</text>
        <input class="form-input" type="number" placeholder="如 1990" placeholder-class="form-ph" value="{{archForm.birth_year}}" bindinput="onArchInput" data-field="birth_year" maxlength="4" />
      </view>
      <view class="form-row">
        <text class="form-label">出生月</text>
        <input class="form-input" type="number" placeholder="1–12" placeholder-class="form-ph" value="{{archForm.birth_month}}" bindinput="onArchInput" data-field="birth_month" maxlength="2" />
      </view>
      <view class="form-row">
        <text class="form-label">出生日</text>
        <input class="form-input" type="number" placeholder="1–31" placeholder-class="form-ph" value="{{archForm.birth_day}}" bindinput="onArchInput" data-field="birth_day" maxlength="2" />
      </view>
      <view class="form-row">
        <text class="form-label">出生时</text>
        <input class="form-input" type="number" placeholder="0–23" placeholder-class="form-ph" value="{{archForm.birth_hour}}" bindinput="onArchInput" data-field="birth_hour" maxlength="2" />
      </view>
      <view class="form-row">
        <text class="form-label">出生分</text>
        <input class="form-input" type="number" placeholder="0–59" placeholder-class="form-ph" value="{{archForm.birth_minute}}" bindinput="onArchInput" data-field="birth_minute" maxlength="2" />
      </view>
      <view class="form-actions">
        <view class="btn-cancel" hover-class="item-press" bindtap="closeArchiveEditor">取消</view>
        <view class="btn-save {{archSaving ? 'disabled' : ''}}" hover-class="item-press" bindtap="onSaveArchive">{{archSaving ? '保存中...' : '保存'}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- ============ 我的积分：混合流水（DF-57，内嵌全屏层，不新增页面 / 不改 app.json） ============ -->
  <view class="fs-page" wx:if="{{showCredits}}" style="padding-top:{{statusBarH}}px;">
    <view class="fs-header">
      <view class="fs-back" hover-class="press-zone" catchtap="closeCredits">
        <text class="fs-back-ico">‹</text>
      </view>
      <text class="fs-title">💎 我的积分</text>
    </view>

    <view class="credits-summary">
      <view class="credits-balance">
        <text class="credits-balance-num">{{creditsBalance === null ? '—' : creditsBalance}}</text>
        <text class="credits-balance-label">当前积分</text>
      </view>
      <view class="credits-today">今日已消耗 {{creditsTodayUsed}} 积分</view>
      <view class="credits-recharge-btn" hover-class="item-press" bindtap="onCreditsRecharge">充值</view>
    </view>

    <scroll-view class="fs-body credits-body" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}"
                 refresher-enabled="{{true}}" refresher-triggered="{{ledgerLoading}}"
                 bindrefresherrefresh="onLedgerRefresh" bindscrolltolower="onLedgerScrollToLower" lower-threshold="80">
      <view class="credits-empty" wx:if="{{ledgerLoading && ledgerItems.length === 0}}">加载中…</view>
      <block wx:elif="{{ledgerItems.length === 0}}">
        <view class="credits-empty" wx:if="{{ledgerError}}">❌ {{ledgerError}}</view>
        <view class="credits-empty" wx:else>暂无积分记录</view>
        <view class="credits-load-more" wx:if="{{ledgerError}}" hover-class="item-press" bindtap="retryLedger">点击重试</view>
      </block>

      <block wx:for="{{ledgerItems}}" wx:key="key">
        <view class="ledger-item {{item.clickable ? 'clickable' : ''}}" data-idx="{{index}}"
              hover-class="{{item.clickable ? 'item-press' : ''}}" bindtap="onLedgerItemTap">
          <view class="ledger-left">
            <text class="ledger-reason">{{item.reasonText}}</text>
            <text class="ledger-question" wx:if="{{item.question}}">{{item.question}}</text>
            <text class="ledger-time">{{item.timeText}}</text>
          </view>
          <view class="ledger-right">
            <text class="ledger-amount {{item.amountCls}}">{{item.sign}}{{item.amount}}</text>
          </view>
        </view>
      </block>

      <view class="credits-load-more" wx:if="{{ledgerItems.length > 0 && ledgerItems.length < ledgerTotal && !ledgerError}}"
            hover-class="item-press" bindtap="onLedgerScrollToLower">
        {{ledgerLoadingMore ? '加载中…' : '加载更多'}}
      </view>
      <view class="credits-load-more" wx:if="{{ledgerItems.length > 0 && ledgerError}}"
            hover-class="item-press" bindtap="retryLedger">加载失败，点击重试</view>
      <view class="credits-empty" wx:if="{{ledgerItems.length > 0 && ledgerItems.length >= ledgerTotal && !ledgerLoadingMore}}">没有更多了</view>
    </scroll-view>
  </view>

  <!-- ============ 登录 / 注册：全屏页面形态（左返回 + 居中标题，无 ✕） ============ -->
  <view class="auth-mask auth-full" wx:if="{{showLogin}}" style="padding-top:{{statusBarH}}px;">
    <view class="auth-sheet auth-full-sheet" catchtap="noop">
      <view class="fs-header">
        <view class="fs-back" hover-class="press-zone" catchtap="closeLogin">
          <text class="fs-back-ico">‹</text>
        </view>
        <text class="fs-title">万机决策助手</text>
      </view>

      <scroll-view class="auth-scroll" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="auth-logo">✦</view>
      <view class="auth-sub">登录后查看咨询记录</view>

      <view class="auth-tabs">
        <view class="auth-tab {{authMode === 'login' ? 'active' : ''}}" hover-class="item-press" bindtap="switchAuthTab" data-tab="login">登录</view>
        <view class="auth-tab {{authMode === 'register' ? 'active' : ''}}" hover-class="item-press" bindtap="switchAuthTab" data-tab="register">注册</view>
      </view>

      <view class="auth-form">
        <view class="auth-field">
          <input class="auth-input" value="{{loginUser}}" bindinput="onLoginUser" placeholder="用户名" placeholder-class="auth-ph" />
        </view>
        <view class="auth-field">
          <input class="auth-input" value="{{loginPwd}}" password bindinput="onLoginPwd" placeholder="密码" placeholder-class="auth-ph" />
        </view>

        <block wx:if="{{authMode === 'register'}}">
          <view class="auth-field">
            <input class="auth-input" value="{{loginPwd2}}" password bindinput="onLoginPwd2" placeholder="确认密码" placeholder-class="auth-ph" />
          </view>
          <view class="auth-field">
            <input class="auth-input" value="{{loginName}}" bindinput="onLoginName" placeholder="昵称（选填）" placeholder-class="auth-ph" />
          </view>
        </block>

        <view class="auth-submit" wx:if="{{authMode === 'login'}}" hover-class="press-zone" bindtap="doLogin">登录</view>
        <view class="auth-submit" wx:else hover-class="press-zone" bindtap="doRegister">注 册</view>
        <view class="auth-error">{{authError}}</view>
      </view>

      <!-- 参考页没有这一段，属于小程序真机调试保留的既有能力 -->
      <view class="server-box">
        <view class="server-label">接口地址（真机调试可改成局域网 IP）</view>
        <view class="server-row">
          <input class="auth-input" value="{{apiOrigin}}" bindinput="onApiOrigin" placeholder="https://estock.space" placeholder-class="auth-ph" />
          <view class="mini-btn" bindtap="saveApiOrigin">保存</view>
        </view>
      </view>

      <view class="auth-cancel" bindtap="closeLogin">稍后再说</view>
      </scroll-view>
    </view>
  </view>

  <!-- ============ 积分消耗确认（对齐参考页自绘卡片） ============ -->
  <view class="cost-mask" wx:if="{{costOpen}}" catchtap="cancelCost">
    <view class="cost-card" catchtap="noop">
      <view class="cost-head">
        <text class="cost-ico">💎</text>
        <text class="cost-title">积分消耗确认</text>
      </view>

      <view class="cost-body">
        <view class="cost-line">检测到你当前已关联 <text class="cost-gold">{{costTypesText}}</text> 信息，进行深度解读将消耗 <text class="cost-pink">{{costCredits}}</text> 积分。</view>
        <view class="cost-note">
          <text class="cost-note-line">· 每次深度解读固定消耗 {{costCredits}} 积分（根问题与追问各计 1 次；追加技能信息不额外扣积分）</text>
          <text class="cost-note-line">· 积分不足时请先到个人中心充值</text>
        </view>
      </view>

      <view class="cost-foot">
        <view class="cost-btn ghost" hover-class="press-zone" bindtap="cancelCost">暂不消耗</view>
        <view class="cost-btn primary" hover-class="press-zone" bindtap="confirmCostYes">确认消耗</view>
      </view>
    </view>
  </view>

  <!-- ============ 删除确认：参考页 ui-dialogs.confirm 的浅色自绘确认框 ============ -->
  <view class="qd-mask" wx:if="{{delOpen}}" catchtap="cancelDelete">
    <view class="qd-box" catchtap="noop">
      <view class="qd-title">确认删除</view>
      <view class="qd-content">{{delText || '确定要删除这条咨询记录（含其下所有追问）吗？删除后无法恢复。'}}</view>
      <view class="qd-actions">
        <view class="qd-btn cancel" hover-class="qd-btn-press" bindtap="cancelDelete">取消</view>
        <view class="qd-btn ok" hover-class="qd-btn-press" bindtap="confirmDelete">确定</view>
      </view>
    </view>
  </view>
</view>
