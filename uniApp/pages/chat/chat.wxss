}

.cost-note-line { display: block; }

.cost-foot {
  display: flex;
  padding: 20rpx 32rpx 28rpx;
  border-top: 1rpx solid rgba(147, 112, 219, .15);
}

.cost-btn {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 20rpx;
  text-align: center;
  font-size: 26rpx;
}

.cost-btn.ghost {
  margin-right: 20rpx;
  color: #b8a5d5;
  background: rgba(255, 255, 255, .08);
  border: 1rpx solid rgba(147, 112, 219, .3);
}

.cost-btn.primary {
  font-weight: 600;
