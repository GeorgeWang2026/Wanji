  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(0, 0, 0, .6);
  /* 参考页有 blur(4px)；部分安卓端 backdrop-filter 不生效，会退化为纯半透明遮罩 */
