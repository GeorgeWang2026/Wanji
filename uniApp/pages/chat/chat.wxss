/* ============================================================
 * 首页：视觉对齐 xiaoxuan.html
 * 配色 / 圆角 / 阴影 / 动效均取自参考页内联样式（px→rpx 约 2 倍）
 * ============================================================ */

.app {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
  background: linear-gradient(160deg, #1e1033 0%, #2d1b4e 40%, #1a0f2e 100%);
}

/* ================= 顶部：您的咨询 ================= */
.panel-top {
  flex: 0 0 auto;
  padding: 24rpx 32rpx 16rpx;
  position: relative;
  z-index: 30;
}

.panel-header {
  position: relative;
  display: flex;
  align-items: center;
  height: 60rpx;
}

.ph-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(147, 112, 219, .25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

/* 圆形刷新按钮按压态（原来只有右侧文字按钮，无按压态） */
.ph-icon-press { background: rgba(147, 112, 219, .45); }

/* 标题组绝对居中；折叠三角紧贴标题左侧，不再占最右位置 */
.p-head {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
}

.p-head .p-title {
  flex: none;
  margin-left: 0;
  white-space: nowrap;
}

.p-head .p-arrow {
  position: absolute;
  right: 100%;
  margin-right: 10rpx;
  padding-left: 0;
}

.p-title {
  flex: 1;
  margin-left: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #b8a5d5;
}

.p-arrow {
  font-size: 22rpx;
  color: #8a75b0;
  /* 收起：尖头朝下；展开：尖头朝上 */
  transform: rotate(0deg);
  transition: transform .25s ease;
  padding-left: 8rpx;
}

.p-arrow.open { transform: rotate(180deg); }

/* 展开时覆盖式浮层，不挤压头像舞台
   参考页 .panel-top .panel-body：absolute top:100% / left-right:16px / z-index:6 /
   max-height:min(80vh+50px,100dvh-110px) / bg rgba(22,12,40,.96) */
.panel-body {
  position: absolute;
  top: 100%;
  left: 32rpx;
  right: 32rpx;
  z-index: 6;
  max-height: 0;
  padding: 0 28rpx;
  margin-top: 12rpx;
  border-radius: 24rpx;
  background: rgba(22, 12, 40, .96);
  border: 2rpx solid rgba(255, 255, 255, .08);
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, .5);
  overflow: hidden;
  opacity: 0;
  font-size: 28rpx;
  line-height: 1.7;
  color: #e8dff5;
  transition: max-height .3s ease, opacity .25s ease, padding .25s ease;
}

.panel-body.open {
  max-height: calc(80vh + 100rpx);
  max-height: min(calc(80vh + 100rpx), calc(100vh - 220rpx));
  padding: 24rpx 28rpx;
  overflow-y: auto;
  opacity: 1;
}

/* ---- 空提示（参考页 .pc-empty-hint） ---- */
.pc-empty-hint {
  padding: 24rpx 8rpx;              /* 12px 4px */
  font-size: 26rpx;                /* 13px */
  line-height: 1.5;
  color: rgba(255, 255, 255, .55);
  text-align: center;
}

/* DF-64：空闲期顶部金句轮播（纯文字，200ms 淡入） */
.idle-quote-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.6;
  color: #d7cdec;
  animation: quote-fade .2s ease;
}
.idle-quote-author {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9b86c4;
  text-align: right;
}
.idle-quote-translation {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, .5);
}
@keyframes quote-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 参考页 #pinnedContext 展开后是 display:block（inline style），子块靠自身 margin 排布 */
.pinned-context {
  display: block;
  padding: 0 0 16rpx;               /* 0 0 8px */
  margin-bottom: 12rpx;             /* 6px */
  border-bottom: 2rpx solid rgba(147, 112, 219, .18);
  max-height: calc(80vh - 80rpx);
  overflow-y: auto;
  overflow-x: hidden;
}

/* 参考页由 _renderChatRoot 产出 .chat-item-header，再改 badge 文案为「您的问题」 */
.pinned-context .chat-item-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #9b87b5;
}

.pinned-context .chat-item-header .mode-badge {
  padding: 4rpx 18rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #b8a5d5;
  background: rgba(147, 112, 219, .2);
}

/* 参考页 header 内追加的 .mode-badge「查看咨询报告」：margin-left:auto */
.pinned-context .pc-report { margin-left: auto; }
.pc-report-press { background: rgba(147, 112, 219, .32) !important; color: #ecdcff !important; }

.pinned-context .chat-item-question {
  color: #ffffff;
  font-size: 29rpx;                /* 14.5px */
  line-height: 1.7;
  font-weight: 600;
  margin-bottom: 12rpx;
  padding: 16rpx 24rpx;
  background: rgba(147, 112, 219, .22);
  border-radius: 16rpx;
  border-left: 6rpx solid #b886e0;
  word-break: break-word;
}

.pinned-context .chat-item-followups {
  display: flex;
  flex-direction: column;
  gap: 12rpx;                       /* 6px */
  margin: 8rpx 0;
}

.pinned-context .chat-item-followup {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  color: #c8b5e8;
  font-size: 25rpx;                /* 12.5px */
  line-height: 1.6;
  padding: 10rpx 20rpx;
  margin-top: 8rpx;
  background: rgba(255, 255, 255, .03);
  border-radius: 12rpx;
  border-left: 4rpx solid rgba(147, 112, 219, .45);
}

.pinned-context .chat-item-followup .cif-tag {
  flex: 0 0 auto;
  font-size: 20rpx;
  color: #b886e0;
  border: 2rpx solid rgba(147, 112, 219, .5);
  border-radius: 8rpx;
  padding: 0 10rpx;
  line-height: 32rpx;
  margin-top: 2rpx;
}

/* ---- 已发送预览（参考页 .sent-preview） ---- */
.sent-preview {
  padding: 20rpx 28rpx;            /* 10px 14px */
  margin-bottom: 8rpx;
  background: rgba(147, 112, 219, .12);
  border: 2rpx solid rgba(147, 112, 219, .3);
  border-radius: 20rpx;
}

.sent-badge {
  display: inline-block;
  font-size: 22rpx;                /* 11px */
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #b59aff;
  background: rgba(147, 112, 219, .18);
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
  margin-bottom: 12rpx;
}

/* 参考页 #sentFeishuBadge：跟在「已发送」后面，紫色文字链接 */
.sent-feishu-badge {
  margin-left: 12rpx;
  color: #9370db;
}

.sent-content {
  font-size: 26rpx;                /* 13px */
  line-height: 1.65;
  color: #e8dff5;
  white-space: pre-wrap;
  word-break: break-word;
  max-height: 200rpx;              /* 100px */
  overflow-y: auto;
}

/* ---- 语音字幕区（参考页 .tts-lines / #ttsBody） ---- */
.tts-lines {
  position: relative;
  padding: 8rpx 12rpx;             /* 4px 6px */
  margin-bottom: 8rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, .05);
  border: 2rpx solid rgba(255, 255, 255, .08);
}

.tts-lines .tts-body {
  min-height: calc(2 * 1.7em);
  max-height: calc(15 * 1.7em);
  overflow-y: auto;
  padding: 12rpx 56rpx 12rpx 20rpx;   /* 右侧留出音量按钮 */
  font-size: 26rpx;                   /* 13px */
  line-height: 1.7;
}

.tts-lines .placeholder {
  color: #6a5a85;
  font-size: 26rpx;
  font-style: italic;
}

.tts-lines .sr-label {
  display: inline-block;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #9370db;
  background: rgba(147, 112, 219, .18);
}

.tts-lines .sr-text {
  white-space: pre-wrap;
  word-break: break-word;
  color: #e8dff5;
}

.thinking-marquee { color: #c9bce2; }

/* DF-64：等待期金句（原文 + 作者右对齐 + 译文） */
.quote-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.6;
  color: #e3d8f5;
}
.quote-author {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9b86c4;
  text-align: right;
}
.quote-translation {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, .5);
}

.dot-flash {
  color: #9370db;
  animation: dot-flash 1.2s ease-in-out infinite;
}

@keyframes dot-flash {
  0%, 100% { opacity: .3; }
  50% { opacity: 1; }
}

/* 保留项：参考页没有这个控件，小程序用它暂停/恢复播报、长按关闭自动播报 */
.tts-vol {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(147, 112, 219, .22);
  border: 1rpx solid rgba(147, 112, 219, .35);
}

.tts-vol.on {
  background: rgba(147, 112, 219, .45);
  border-color: rgba(147, 112, 219, .6);
}

.tts-vol.muted {
  background: rgba(255, 255, 255, .05);
  border-color: rgba(255, 255, 255, .12);
}

.tts-vol-ico { font-size: 22rpx; line-height: 1; }

/* ---- 绑定标签（参考页 .bound-tags / .bound-tag） ---- */
.bound-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;                       /* 6px */
  padding: 0 0 12rpx;
}

.bound-tag {
  display: flex;
  align-items: center;
  gap: 10rpx;                       /* 5px */
  max-width: 100%;
  padding: 8rpx 20rpx 8rpx 16rpx;   /* 4px 10px 4px 8px */
  border-radius: 32rpx;             /* 16px */
  font-size: 24rpx;                 /* 12px */
  color: #e8dff5;
  background: linear-gradient(135deg, rgba(147, 112, 219, .45), rgba(100, 80, 170, .35));
  border: 2rpx solid rgba(147, 112, 219, .5);
}

.bound-tag-press { box-shadow: 0 4rpx 20rpx rgba(147, 112, 219, .3); }

.bound-tag.bazi {
  background: linear-gradient(135deg, rgba(80, 170, 200, .4), rgba(60, 120, 180, .3));
  border-color: rgba(80, 170, 200, .45);
}

.bound-tag.meihua {
  background: linear-gradient(135deg, rgba(200, 140, 80, .4), rgba(170, 100, 60, .3));
  border-color: rgba(200, 140, 80, .45);
}

.bound-tag.stock {
  background: linear-gradient(135deg, rgba(60, 150, 120, .4), rgba(40, 110, 160, .3));
  border-color: rgba(60, 170, 150, .45);
}

.bound-tag .bt-icon {
  font-size: 28rpx;
  opacity: .9;
}

.bound-tag .bt-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #e8dff5;
  white-space: nowrap;
}

.bound-tag .bt-detail {
  font-size: 22rpx;
  opacity: .7;
  margin-left: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bound-tag .bt-close {
  flex: 0 0 auto;
  width: 32rpx;
  height: 32rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 22rpx;
  color: #d8bfd8;
  background: rgba(255, 255, 255, .12);
}

/* ================= 中部：头像舞台 ================= */
.stage {
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0 0;
  position: relative;
}

.status-tag {
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  letter-spacing: 1rpx;
  white-space: nowrap;
  color: #e0d0f0;
  background: rgba(60, 30, 80, .9);
  box-shadow: 0 8rpx 32rpx rgba(60, 30, 80, .4);
  opacity: 0;
  transition: opacity .3s;
}

.status-tag.show { opacity: 1; }

.avatar-wrap {
  position: relative;
  width: 560rpx;
  height: 560rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 旋转光环：conic-gradient + rotate（部分低版本安卓会退化为静态环） */
.avatar-ring {
  position: absolute;
  left: -14rpx;
  top: -14rpx;
  right: -14rpx;
  bottom: -14rpx;
  border-radius: 50%;
  background: conic-gradient(from 0deg, rgba(147, 112, 219, 0), rgba(147, 112, 219, .6), rgba(255, 182, 193, .5), rgba(147, 112, 219, .6), rgba(147, 112, 219, 0));
  opacity: .5;
  animation: ring-spin 8s linear infinite;
}

.avatar-ring.idle {
  animation-play-state: paused;
  opacity: .2;
}

/* 录音脉冲圈 */
.pulse-ring {
  position: absolute;
  left: -28rpx;
  top: -28rpx;
  right: -28rpx;
  bottom: -28rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 100, 120, .5);
  opacity: 0;
}

.pulse-ring.active { animation: pulse 1.2s ease-out infinite; }

.avatar-img {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, .95);
  background: #f8f5ff;
  box-shadow: 0 16rpx 56rpx rgba(147, 112, 219, .35);
}

.avatar-wrap.is-listening .avatar-img {
  box-shadow: 0 0 0 6rpx rgba(255, 100, 120, .35), 0 0 56rpx rgba(255, 100, 120, .55);
}

/* 头像图片容器：口型层相对它定位（百分比），与 avatar-img 同尺寸 */
.avatar-stage {
  position: relative;
  width: 100%;
  height: 100%;
  z-index: 2;
}

/* 口型层：默认隐藏，播报时 .on 显示；定位由内联 style 百分比给出 */
.mouth-overlay {
  position: absolute;
  display: none;
  z-index: 3;
}
.mouth-overlay.on { display: block; }
.mouth-img {
  width: 100%;
  height: 100%;
  display: block;
  transform-origin: 50% 50%;
}

/* ---- 我的档案（DF-56）：列表卡片 ---- */
.archives-empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: rgba(224, 208, 240, .5);
  font-size: 26rpx;
}
.arch-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 28rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, .06);
  border: 2rpx solid rgba(255, 255, 255, .08);
}
.arch-main { display: flex; flex-direction: column; flex: 1; min-width: 0; }
.arch-name { font-size: 30rpx; font-weight: 600; color: #f0e6ff; }
.arch-sub { margin-top: 8rpx; font-size: 24rpx; color: rgba(224, 208, 240, .6); }
.arch-del {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #ff9aa8;
  background: rgba(255, 100, 120, .12);
}
.arch-add {
  margin: 28rpx;
  padding: 26rpx;
  text-align: center;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #c9a3ff;
  border: 2rpx dashed rgba(201, 163, 255, .45);
}

/* ---- 我的档案（DF-56）：编辑表单 ---- */
.form-row {
  display: flex;
  align-items: center;
  margin: 18rpx 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, .06);
}
.form-label { width: 150rpx; flex-shrink: 0; font-size: 28rpx; color: #d8c8f0; }
.form-input { flex: 1; font-size: 28rpx; color: #f0e6ff; }
.form-ph { color: rgba(224, 208, 240, .35); }
.form-picker { flex: 1; font-size: 28rpx; color: #f0e6ff; }
.form-actions { display: flex; margin: 40rpx 28rpx 60rpx; }
.btn-cancel, .btn-save {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 18rpx;
  font-size: 30rpx;
}
.btn-cancel { margin-right: 12rpx; color: #d8c8f0; background: rgba(255, 255, 255, .08); }
.btn-save { margin-left: 12rpx; color: #1a0f2e; background: linear-gradient(135deg, #b388ff, #7c4dff); font-weight: 600; }
.btn-save.disabled { opacity: .5; }

.avatar-fallback {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid rgba(255, 255, 255, .95);
  background: linear-gradient(135deg, #9370db, #ffb6c1);
  box-shadow: 0 16rpx 56rpx rgba(147, 112, 219, .35);
}

.fallback-txt {
  font-size: 140rpx;
  font-weight: 700;
  color: #fff;
}

.avatar-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #d8c8ee;
  background: rgba(147, 112, 219, .28);
  border: 1rpx solid rgba(255, 255, 255, .18);
}

.avatar-nav.prev { left: -86rpx; }
.avatar-nav.next { right: -86rpx; }

/* 排盘快捷圆钮 */
.paipan-bar {
  display: flex;
  justify-content: center;
  margin-top: 48rpx;
}

.paipan-btn {
  width: 100rpx;
  height: 100rpx;
  margin: 0 14rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #e8dff5;
  background: rgba(255, 255, 255, .06);
  border: 3rpx solid rgba(147, 112, 219, .35);
}

.paipan-btn.active {
  background: rgba(147, 112, 219, .5);
  border-color: rgba(147, 112, 219, .65);
  box-shadow: 0 0 28rpx rgba(147, 112, 219, .35);
}

.paipan-btn .p-icon { font-size: 34rpx; line-height: 1; }

.paipan-btn .p-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #c8b8e8;
}

/* ================= 底部：输入面板 ================= */
.panel-bot {
  flex: 0 0 auto;
  padding: 0 32rpx;
  position: relative;
  z-index: 20;
}

.panel-bot .panel-header {
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, .04);
  border: 1rpx solid rgba(255, 255, 255, .07);
}

.panel-bot.open .panel-header {
  background: rgba(147, 112, 219, .12);
  border-color: rgba(147, 112, 219, .28);
}

.panel-bot.open {
  /* 展开时抬升层级，浮层要压在头像导航 / 状态胶囊 / 排盘按钮之上 */
  z-index: 40;
}

/* 收起态不渲染（WXML 用 wx:if 控制），这里只定义浮层外观 */
.panel-bot .panel-body {
  margin: 0;
  padding: 20rpx 24rpx;
  max-height: none;
  opacity: 1;
  border-radius: 20rpx 20rpx 0 0;
  background: linear-gradient(160deg, #241540, #1a0f2e);
  border: 1rpx solid rgba(147, 112, 219, .25);
  border-bottom: none;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, .55);
  overflow-y: auto;
}

/*
 * 展开态：向上生长，底边与「输入问题」标题上沿衔接
 * - bottom:calc(100% - 2rpx)：底边落在标题上沿并压住 2rpx，避免出现缝隙
 * - top:auto：只由 bottom 定位，高度随内容自然增长
 * - max-height 限高，超出后在浮层内部滚动，不影响上方元素布局
 * - .panel-bot 本身不改变高度，头像 / 排盘按钮 / 标题都不位移
 */
.panel-bot.open .panel-body {
  position: absolute;
  top: auto;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(100% - 2rpx);
  z-index: 2;
  max-height: 52vh;
  animation: panel-up .26s ease;
}

.p-sub {
  font-size: 22rpx;
  color: #7c6a9b;
  padding-right: 8rpx;
}

.quick-qas {
  display: flex;
  flex-direction: column;
  margin-bottom: 12rpx;
  max-height: 340rpx;
  overflow-y: auto;
}

.quick-qa {
