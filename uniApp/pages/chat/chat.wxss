  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* DF-81：证券态轻量高亮（复用现有卡片样式，仅加暖色高亮，不新造配色体系） */
.quick-qa.stock-themed {
  color: #e8d9a8;
  background: rgba(232, 217, 168, .08);
  border-left: 4rpx solid rgba(232, 217, 168, .45);
}

.input-row {
  display: flex;
  align-items: flex-end;
}

.rec-input-wrap {
  position: relative;
  flex: 1;
  min-width: 0;
}

.rec-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 76rpx;
  max-height: 220rpx;
  padding: 18rpx 56rpx 18rpx 22rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #e8dff5;
  background: rgba(255, 255, 255, .08);
  border: 1rpx solid rgba(147, 112, 219, .25);
}

.rec-clear {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1;
  color: #c4b5e0;
  background: rgba(255, 255, 255, .10);
}

/* 触控热区扩展到 52rpx，视觉仍 40rpx */
.rec-clear::after {
  content: '';
  position: absolute;
  left: -6rpx;
  top: -6rpx;
  right: -6rpx;
  bottom: -6rpx;
}

.rec-input-ph { color: #6a5a85; font-style: italic; }

.rec-send {
  flex: 0 0 auto;
  width: 76rpx;
  height: 76rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #9370db, #b886e0);
  box-shadow: 0 4rpx 20rpx rgba(147, 112, 219, .35);
}

.rec-send.disabled { opacity: .4; }

.input-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.rec-hint { font-size: 22rpx; color: #ff8fb5; }

.rec-count { font-size: 22rpx; color: #6a5a85; }

/* ================= 底部控制区 ================= */
.controls {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0 calc(24rpx + env(safe-area-inset-bottom));
}

.ctrl-btn {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  margin: 0 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c4b5e0;
  background: rgba(255, 255, 255, .12);
}

.ctrl-ico { width: 44rpx; height: 44rpx; display: block; }

/* 点击态对齐网页 .ctrl-btn:active（scale .92 + 底色加深），只作用于底部三按钮 */
.ctrl-press { transform: scale(.92); background: rgba(255, 255, 255, .2); }
.mic-press { transform: scale(.92); }

.ctrl-dot {
  position: absolute;
  top: 8rpx;
  right: 10rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff6478;
  box-shadow: 0 0 8rpx rgba(255, 100, 120, .9);
}

.mic-btn {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: linear-gradient(135deg, #9370db, #b088e0);
  box-shadow: 0 12rpx 40rpx rgba(147, 112, 219, .45);
}

.mic-btn.recording {
  background: linear-gradient(135deg, #ff6478, #ff8fa0);
  animation: mic-pulse 1.2s ease-out infinite;
}

/* DF-53 复验：切图已裁到内容包围盒，麦克风取兜底尺寸 56rpx，抵消窄画幅带来的视觉偏小 */
.mic-ico { width: 56rpx; height: 56rpx; display: block; }

.mic-btn.recording .mic-ico {
  transform-origin: center;
  animation: mic-shake .45s ease-in-out infinite;
}

@keyframes mic-shake {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-12deg); }
  75% { transform: rotate(12deg); }
}

.press-zone { opacity: .82; transform: scale(.96); }

/* ================= 弹层通用（咨询记录 / 个人中心） ================= */
