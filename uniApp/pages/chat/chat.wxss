}

.cost-ico { margin-right: 20rpx; font-size: 40rpx; }

.cost-title { font-size: 28rpx; font-weight: 600; color: #e8dff5; }

.cost-body { padding: 32rpx 36rpx; }

.cost-line {
  margin-bottom: 16rpx;
  font-size: 26rpx;
