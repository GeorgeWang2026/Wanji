/* ================= 动画 ================= */
@keyframes ring-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes pulse {
  0% { transform: scale(.96); opacity: .9; }
  100% { transform: scale(1.14); opacity: 0; }
}

@keyframes mic-pulse {
  0% { box-shadow: 0 0 0 0 rgba(255, 100, 120, .6); }
  70% { box-shadow: 0 0 0 32rpx rgba(255, 100, 120, 0); }
  100% { box-shadow: 0 0 0 0 rgba(255, 100, 120, 0); }
}

@keyframes blink {
  0%, 80%, 100% { opacity: .25; }
  40% { opacity: 1; }
}

@keyframes sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 输入面板展开：从标题上沿向上滑出（不参与布局） */
@keyframes panel-up {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ============================================================
 * 咨询记录弹层：1:1 照搬 xiaoxuan.html #chatHistoryModal
 * 参考源码：xiaoxuan.html 695-703（mask/box/header/close/body）、860-990（.chat-item 全量）
 * 换算规则：参考页 px × 2 = rpx；class 名、DOM 层级、属性顺序照抄。
 * 选择器统一加 #chatHistoryModal 前缀：仅用于压过本页遗留的旧咨询记录样式，
 * 不改变任何声明值。
 * 全局说明：网页端的 cursor / user-select / :hover / :active 在小程序无鼠标，
 * 一律略去；:active 反馈用 WXML 的 hover-class 还原（见下方 *-press 规则）。
 * ============================================================ */

/* ---- .modal-mask ---- */
#chatHistoryModal.modal-mask {
  /* 原 CSS：position:absolute; inset:0（相对 .app 容器）
     → 替代：position:fixed + 四边 0（小程序 WXSS 不支持 inset 简写；.app 已满屏，视觉等价） */
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, .6);
  z-index: 49;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;               /* 20px */
  overflow: hidden;
  /* 原 CSS：backdrop-filter:blur(4px) → 保留并补 -webkit- 前缀；
     Android 部分机型不支持该属性，属系统渲染限制，无等价替代 */
  -webkit-backdrop-filter: blur(4px);
  backdrop-filter: blur(4px);
  /* 原 CSS：border-radius:inherit → .app 无圆角，等价 0，省略 */
  /* 原 CSS：.modal-mask.show{display:flex;animation:fade-in .2s} → wx:if 控制显隐，动画直接挂在遮罩上 */
  animation: fade-in .2s ease;
}

/* ---- .modal-box（含 #chatHistoryModal 覆盖） ---- */
#chatHistoryModal .modal-box {
  /* 原 CSS：#chatHistoryModal .modal-box{width:100%;max-width:100%;max-height:100%;height:100%;border-radius:14px;border:none;} */
  width: 100%;
  max-width: 100%;
  height: 100%;
  max-height: 100%;
  border-radius: 28rpx;         /* 14px */
  border: none;
  background: linear-gradient(160deg, #2a1a4a, #1e1033);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 40rpx 120rpx rgba(0, 0, 0, .5);   /* 0 20px 60px */
  animation: slide-up .25s ease;                 /* 原 slide-up 用 20px → 40rpx，见文件末尾 keyframes */
}

/* ---- .modal-header ---- */
#chatHistoryModal .modal-header {
  padding: 28rpx 32rpx;                          /* 14px 16px */
  border-bottom: 2rpx solid rgba(180, 140, 220, .15);
  display: flex;
  align-items: center;
  gap: 20rpx;                                    /* 10px */
  background: linear-gradient(135deg, rgba(147, 112, 219, .15), rgba(255, 182, 193, .08));
}

/* 原 CSS：.modal-header h3{flex:1;font-size:15px;color:#e0d0f0;letter-spacing:1px}
   → 替代：#chatHistoryModal .modal-title（小程序无 h3；<text> 默认不加粗，
     h3 的浏览器默认 font-weight:bold 用 700 显式补齐，其余属性原样） */
#chatHistoryModal .modal-title {
  flex: 1;
  margin: 0;
  font-size: 30rpx;                              /* 15px */
  font-weight: 700;
  color: #e0d0f0;
  letter-spacing: 2rpx;                          /* 1px */
}

/* 原 CSS：.modal-close 为 <button>（浏览器默认 border/padding）
   → 替代：<view> + border:none（view 无默认边框，无需清 padding） */
#chatHistoryModal .modal-close {
  width: 56rpx;                                  /* 28px */
  height: 56rpx;
  border-radius: 50%;
  border: none;
  background: rgba(255, 255, 255, .1);
  color: #c4b5e0;
  font-size: 32rpx;                              /* 16px */
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 原 CSS：.modal-close:active{background:rgba(255,255,255,.2)} → hover-class */
#chatHistoryModal .modal-close-press { background: rgba(255, 255, 255, .2); }

/* 原 CSS：.modal-body{flex:1;overflow-y:auto;padding:12px}
   → 替代：<scroll-view> 必须有确定高度才能滚动，flex:1 + height:0 等价占满剩余高度 */
#chatHistoryModal .modal-body {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 24rpx;                                /* 12px */
  /* 原 CSS：.modal-body::-webkit-scrollbar{width:4px} / thumb 紫色
     → 小程序无法自定义滚动条，WXML 用 show-scrollbar="{{false}}" 隐藏（限制项） */
}

/* ---- .chat-item ---- */
#chatHistoryModal .chat-item {
  background: rgba(255, 255, 255, .05);
  border: 2rpx solid rgba(255, 255, 255, .08);
  border-radius: 24rpx;                          /* 12px */
  padding: 24rpx;                                /* 12px */
  margin-bottom: 20rpx;                          /* 10px */
  transition: background .15s;
}

/* 原 CSS：.chat-item:active{background:rgba(255,255,255,.08)} → hover-class */
#chatHistoryModal .chat-item-press { background: rgba(255, 255, 255, .08); }

#chatHistoryModal .chat-item-header {
  display: flex;
  align-items: center;
  gap: 16rpx;                                    /* 8px */
  margin-bottom: 12rpx;                          /* 6px */
  font-size: 24rpx;                              /* 12px */
  color: #9b87b5;
}

#chatHistoryModal .chat-item-header .mode-badge {
  margin: 0;                                     /* 覆盖本页旧 .mode-badge 的 margin-right（参考页用 gap） */
  background: rgba(147, 112, 219, .2);
  color: #b8a5d5;
  padding: 4rpx 18rpx;                           /* 2px 9px */
  border-radius: 16rpx;                          /* 8px */
  font-size: 22rpx;                              /* 11px */
  font-weight: 600;
}

#chatHistoryModal .chat-item-header .mode-badge.mock {
  background: rgba(255, 182, 193, .18);
  color: #d5b5c5;
}

/* 原 CSS：.chat-item-header .del-btn{...cursor:pointer;font-size:13px} → 去掉 cursor */
#chatHistoryModal .chat-item-header .del-btn {
  margin-left: auto;
  padding: 0;                                    /* 覆盖本页旧 .del-btn 的 padding-left */
  background: none;
  border: none;
  color: #8a75b0;
  font-size: 26rpx;                              /* 13px */
  /* 原 CSS 未设 line-height（<button> 取浏览器默认 normal）
     → 替代：显式 line-height:normal；否则 <view> 会继承 page 的 1.6，行高偏高 */
  line-height: normal;
}

#chatHistoryModal .del-btn-press { color: #ff6478; }

/* ---- 报告行：飞书 + 继续追问，同一行各占一半 ---- */
#chatHistoryModal .chat-item-report {
  display: flex;
  flex-wrap: nowrap;
  gap: 16rpx;                                    /* 8px */
  margin: 16rpx 0;                               /* 8px 0 */
}

#chatHistoryModal .chat-item-report > .xb-feishu-btn,
#chatHistoryModal .chat-item-report > .xb-continue-btn {
  flex: 1 1 0;
  min-width: 0;
  justify-content: center;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 原 CSS：.chat-item .xb-feishu-btn 为 <button>/<a>，line-height:1.5、nowrap
   → 替代：<view>（无默认边框）+ 同名 class，声明值不变 */
#chatHistoryModal .chat-item .xb-feishu-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;                                     /* 4px */
  background: linear-gradient(135deg, rgba(184, 134, 224, .3), rgba(147, 112, 219, .22));
  border: 2rpx solid rgba(184, 134, 224, .55);
  color: #ecdcff;
  border-radius: 16rpx;                          /* 8px */
  padding: 10rpx 28rpx;                          /* 5px 14px */
  font-size: 24rpx;                              /* 12px */
  font-weight: 600;
  line-height: 1.5;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

#chatHistoryModal .xb-feishu-press { background: rgba(184, 134, 224, .42); }

#chatHistoryModal .chat-item .xb-feishu-btn.xb-fs-disabled {
  background: rgba(255, 255, 255, .05);
  border-color: rgba(255, 255, 255, .1);
  color: #6a5a85;
  opacity: .85;
  font-weight: 400;
}

#chatHistoryModal .chat-item .xb-continue-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, rgba(112, 219, 180, .28), rgba(80, 170, 150, .2));
  border: 2rpx solid rgba(112, 219, 180, .5);
  color: #d6fff0;
  border-radius: 16rpx;
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

#chatHistoryModal .xb-continue-press { background: rgba(112, 219, 180, .4); }

/* ---- header 昵称 / 来源 ---- */
#chatHistoryModal .chat-item-header .chat-item-name {
  margin-left: 0;                                /* 覆盖旧样式（参考页用 gap 排版） */
  color: #c8b5e8;
  font-weight: 600;
  max-width: 160rpx;                             /* 80px */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

#chatHistoryModal .chat-item-header .chat-item-source {
  margin-left: 0;                                /* 覆盖旧样式 */
  color: #8a75b0;
  font-size: 20rpx;                              /* 10px */
  opacity: .7;
}

/* ---- 技能卡片容器 ---- */
#chatHistoryModal .chat-item-user {
  color: #e8dff5;
  font-size: 26rpx;                              /* 13px */
  line-height: 1.6;
  margin-bottom: 12rpx;                          /* 6px */
  font-weight: 500;
  padding-left: 20rpx;                           /* 10px */
  border-left: 4rpx solid #9370db;               /* 2px */
}

#chatHistoryModal .chat-pan-cards {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;                                    /* 6px */
  max-width: 100%;
}

#chatHistoryModal .chat-pan-cards .bound-tag { margin-bottom: 0; }

#chatHistoryModal .chat-pan-cards .bound-tag .bt-detail {
  white-space: normal;
  word-break: break-word;
}

/* 原 CSS：.bound-tag（主界面同款胶囊；user-select:none 略去） */
#chatHistoryModal .bound-tag {
  display: flex;
  align-items: center;
  gap: 10rpx;                                    /* 5px */
  padding: 8rpx 20rpx 8rpx 16rpx;                /* 4px 10px 4px 8px */
  border-radius: 32rpx;                          /* 16px */
  font-size: 24rpx;                              /* 12px */
  color: #e8dff5;
  background: linear-gradient(135deg, rgba(147, 112, 219, .45), rgba(100, 80, 170, .35));
  border: 2rpx solid rgba(147, 112, 219, .5);
  max-width: 100%;
}

#chatHistoryModal .bound-tag .bt-icon {
  margin-right: 0;                               /* 覆盖旧的 margin-right（参考页用 gap） */
  font-size: 28rpx;                              /* 14px */
  opacity: .9;
}

#chatHistoryModal .bound-tag .bt-text {
  font-weight: 600;
  white-space: nowrap;
}

#chatHistoryModal .bound-tag .bt-detail {
  font-size: 22rpx;                              /* 11px */
  opacity: .7;
  margin-left: 4rpx;                             /* 2px */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

#chatHistoryModal .bound-tag.bazi {
  background: linear-gradient(135deg, rgba(80, 170, 200, .4), rgba(60, 120, 180, .3));
  border-color: rgba(80, 170, 200, .45);
}

#chatHistoryModal .bound-tag.meihua {
  background: linear-gradient(135deg, rgba(200, 140, 80, .4), rgba(170, 100, 60, .3));
  border-color: rgba(200, 140, 80, .45);
}

#chatHistoryModal .bound-tag.stock {
  background: linear-gradient(135deg, rgba(60, 150, 120, .4), rgba(40, 110, 160, .3));
  border-color: rgba(60, 170, 150, .45);
}

/* 原 CSS 顺序：.chat-pan-tip 写在 .bound-tag 之后，同特异性时后者覆盖前者
   （padding / border / background / 圆角取 .chat-pan-tip 的值），此处保持同样顺序 */
#chatHistoryModal .chat-pan-tip {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 12rpx;                               /* 4px 6px */
  padding: 16rpx 20rpx;                          /* 8px 10px */
  margin-bottom: 12rpx;                          /* 6px */
  background: linear-gradient(135deg, rgba(147, 112, 219, .18), rgba(184, 134, 11, .12));
  border: 2rpx solid rgba(147, 112, 219, .35);
  border-radius: 16rpx;                          /* 8px */
  /* 原 CSS：transition/ hover 阴影 / :active scale → 小程序无 hover，
     点击行为（弹深度解读）当前未实现，故不加 hover-class（见差异清单） */
}

/* ---- 用户问题 ---- */
#chatHistoryModal .chat-item-question {
  color: #ffffff;
  font-size: 29rpx;                              /* 14.5px */
  line-height: 1.7;
  font-weight: 600;
  margin-bottom: 12rpx;                          /* 6px */
  padding: 16rpx 24rpx;                          /* 8px 12px */
  background: rgba(147, 112, 219, .22);
  border-radius: 16rpx;                          /* 8px */
  border-left: 6rpx solid #b886e0;               /* 3px */
  word-break: break-word;
}

/* ---- 追问列表 ---- */
#chatHistoryModal .chat-item-followups { margin: 8rpx 0 16rpx; }   /* 4px 0 8px */

#chatHistoryModal .chat-item-followup {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;                                    /* 6px */
  color: #c8b5e8;
  font-size: 25rpx;                              /* 12.5px */
  line-height: 1.6;
  padding: 10rpx 20rpx;                          /* 5px 10px */
  margin-top: 8rpx;                              /* 4px */
  background: rgba(255, 255, 255, .03);
  border-radius: 12rpx;                          /* 6px */
  border-left: 4rpx solid rgba(147, 112, 219, .45);  /* 2px */
}

#chatHistoryModal .chat-item-followup .cif-tag {
  flex: 0 0 auto;
  font-size: 20rpx;                              /* 10px */
  color: #b886e0;
  border: 2rpx solid rgba(147, 112, 219, .5);
  border-radius: 8rpx;                           /* 4px */
  padding: 0 10rpx;                              /* 0 5px */
  line-height: 32rpx;                            /* 16px */
  margin-top: 2rpx;                              /* 1px */
}

/* ---- 深度解读（折叠区） ---- */
#chatHistoryModal .chat-item-reply {
  color: #d5c8ee;
  font-size: 25rpx;                              /* 12.5px */
  line-height: 1.7;
  padding-left: 20rpx;                           /* 10px */
  border-left: 4rpx solid rgba(255, 182, 193, .5);   /* 2px */
  word-break: break-word;
  display: none;
}

#chatHistoryModal .chat-item.expanded .chat-item-reply { display: block; }

/* 原 CSS：.chat-item-reply h1/h2/h3/b/strong/ol/ul/li/hr/p 逐标签着色
   → 限制：小程序 <rich-text> 内部节点不参与页面 WXSS 选择器匹配，无法逐标签命中；
     这里只保证继承型属性（颜色/字号/行高）与参考页一致。 */
#chatHistoryModal .chat-item-reply rich-text {
  color: #d5c8ee;
  font-size: 25rpx;
  line-height: 1.7;
}

/* ---- 空态 / 加载更多 ---- */
#chatHistoryModal .chat-empty {
  text-align: center;
  color: #6a5a85;
  padding: 80rpx 40rpx;                          /* 40px 20px */
  font-size: 26rpx;                              /* 13px */
}

/* 原 CSS：.chat-load-more{text-align:center;padding:10px;color:#9370db;font-size:12px;cursor:pointer}
   额外清掉本页旧样式（虚线边框 / 圆角 / 外边距），确保与参考页一致 */
#chatHistoryModal .chat-load-more {
  margin: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  text-align: center;
  padding: 20rpx;                                /* 10px */
  color: #9370db;
  font-size: 24rpx;                              /* 12px */
}

#chatHistoryModal .chat-load-more-press { color: #b088e0; }

/* 原 CSS：@keyframes slide-up{from{transform:translateY(20px);opacity:0}...} */
@keyframes slide-up {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

/* ================= 登录 / 注册：全屏页面形态 ================= */
/* 原底部 sheet（圆角 + 底部留白）→ 全屏页；只改容器，表单内容不变 */
.auth-mask.auth-full {
  align-items: stretch;
  background: transparent;
  animation: none;
}

.auth-sheet.auth-full-sheet {
  height: 100%;
  max-height: none;
  padding: 0;
  border: none;
  border-radius: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: none;
}

.auth-scroll {
  flex: 1;
  min-height: 0;
  padding: 48rpx 56rpx calc(64rpx + env(safe-area-inset-bottom));
}

/* ================= 删除确认（参考页 ui-dialogs.confirm 浅色自绘框） ================= */
/* 原实现：wx.showModal（系统样式） → 自绘，与参考页 confirm/confirmCredit 一致 */
.qd-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(0, 0, 0, .5);
}

.qd-box {
  width: 100%;
  max-width: 840rpx;                             /* 参考页 max-width:420px */
  padding: 56rpx 64rpx;                          /* 28px 32px */
  border-radius: 24rpx;                          /* 12px */
  background: #fff;
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, .18);   /* 0 8px 32px */
}

.qd-title {
  margin-bottom: 28rpx;                          /* 14px */
  font-size: 32rpx;                              /* 16px */
  font-weight: 700;
  color: #7a3b1d;
}

.qd-content {
  margin-bottom: 44rpx;                          /* 22px */
  font-size: 27rpx;                              /* 13.5px */
  line-height: 1.7;
  color: #3b2f1d;
  word-break: break-word;
}

.qd-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;                                    /* 10px */
}

.qd-btn {
  padding: 16rpx 36rpx;                          /* 8px 18px */
  border-radius: 16rpx;                          /* 8px */
  font-size: 26rpx;                              /* 13px */
}

.qd-btn.cancel {
  color: #8a7a5f;
  background: #fff;
  border: 3rpx solid #d8ccb0;                    /* 1.5px */
}

.qd-btn.ok {
  padding: 16rpx 40rpx;                          /* 8px 20px */
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #7a3b1d, #b85a2c);
}

.qd-btn-press { opacity: .8; }

/* ============ 技能深度解读全屏层（FB-44，复用 fs-page/fs-header/fs-body） ============ */
#skillAnalysisModal .skill-analysis-body {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 24rpx;                                /* 12px，与 #chatHistoryModal .modal-body 一致 */
  box-sizing: border-box;
}

#skillAnalysisModal .am-empty {
  padding: 120rpx 24rpx;
  text-align: center;
  font-size: 28rpx;
  line-height: 1.7;
  color: rgba(224, 208, 240, .72);
}

#skillAnalysisModal .skill-analysis-retry {
  display: inline-block;
  margin-top: 24rpx;
  padding: 14rpx 44rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #e0d0f0;
  background: rgba(147, 112, 219, .18);
  border: 2rpx solid rgba(147, 112, 219, .5);
}

/* ---- 我的积分（DF-57）：混合流水全屏层 ---- */
.credits-summary {
  flex: 0 0 auto;
  margin: 12rpx 28rpx 12rpx;
  padding: 30rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, .06);
  border: 2rpx solid rgba(255, 255, 255, .08);
}
.credits-balance { display: flex; align-items: baseline; }
.credits-balance-num { font-size: 60rpx; font-weight: 700; color: #f0e6ff; }
.credits-balance-label { margin-left: 16rpx; font-size: 24rpx; color: rgba(224, 208, 240, .6); }
.credits-today { margin-top: 10rpx; font-size: 24rpx; color: rgba(224, 208, 240, .6); }
.credits-recharge-btn {
  margin-top: 22rpx;
  padding: 18rpx 0;
  text-align: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a0f2e;
  background: linear-gradient(135deg, #b388ff, #7c4dff);
}
.credits-body { box-sizing: border-box; }
.ledger-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 28rpx;
  padding: 24rpx 26rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, .05);
  border: 2rpx solid rgba(255, 255, 255, .07);
}
.ledger-item.clickable { background: rgba(255, 255, 255, .07); }
.ledger-left { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.ledger-reason { font-size: 28rpx; font-weight: 600; color: #f0e6ff; }
.ledger-question {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(224, 208, 240, .65);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ledger-time { margin-top: 8rpx; font-size: 22rpx; color: rgba(224, 208, 240, .4); }
.ledger-right { flex-shrink: 0; margin-left: 16rpx; }
.ledger-amount { font-size: 34rpx; font-weight: 700; }
.ledger-amount.amt-increase { color: #7ee2a8; }
.ledger-amount.amt-consume { color: #ff9aa8; }
.credits-empty { padding: 120rpx 40rpx; text-align: center; color: rgba(224, 208, 240, .5); font-size: 26rpx; }
.credits-load-more { padding: 28rpx; text-align: center; font-size: 26rpx; color: #c9a3ff; }
