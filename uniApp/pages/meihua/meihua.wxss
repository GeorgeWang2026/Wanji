.page { padding: 20rpx 24rpx 40rpx; }

/* 起卦方式 */
.tabs {
  display: flex;
  padding: 6rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, .05);
  border: 1rpx solid rgba(147, 112, 219, .25);
  margin-bottom: 18rpx;
}

.tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 24rpx;
  color: #a692c4;
  border-radius: 12rpx;
}

.tab-on {
  color: #1a0f2e;
  font-weight: 600;
  background: linear-gradient(135deg, #e8b84a, #f0d48a);
}

/* 条件 */
.cond {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, .05);
  border: 1rpx solid rgba(147, 112, 219, .25);
  margin-bottom: 16rpx;
}

.cond-row { display: flex; align-items: center; margin-bottom: 10rpx; }
.cond-row:last-child { margin-bottom: 0; }

.cond-label { width: 96rpx; font-size: 24rpx; color: #9f8ac0; }
.cond-label-2 { width: 96rpx; margin-left: 8rpx; }

.picker { flex: 1; margin-right: 8rpx; }
.picker-wide { flex: 1; }

.pick-val {
  height: 66rpx;
  line-height: 66rpx;
  text-align: center;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #e8dff5;
  background: rgba(147, 112, 219, .14);
  border: 1rpx solid rgba(147, 112, 219, .3);
}

.num-input {
  flex: 1;
  height: 66rpx;
  margin-right: 8rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #e8dff5;
  background: rgba(147, 112, 219, .14);
  border: 1rpx solid rgba(147, 112, 219, .3);
}

.ph { color: #7d6b9c; }

/* DF-82：时间栏与奇门同源——年/月/日/时（含分）四格一排，窄屏（320）也不换行 */
.cond-row4 { flex-wrap: nowrap; }
.picker.p4 { flex: 1 1 0; min-width: 0; margin-right: 8rpx; }
/* 时间行下拉高度与奇门一致（68rpx），单位后缀与两位补零同源 */
.picker.p4 .pick-val { height: 68rpx; line-height: 68rpx; font-size: 24rpx; padding: 0 4rpx; overflow: hidden; white-space: nowrap; }
.pick-u { font-size: 20rpx; color: #9f8ac0; margin-left: 2rpx; }

/* DF-82：时间行「当前时间」图标（与奇门同图 qm-now.png、同显示尺寸 44×44rpx、同热区 ≥100rpx） */
.now-btn { flex: 0 0 auto; padding: 16rpx; margin: -16rpx; }
.now-btn-inner {
  width: 56rpx;
  height: 68rpx;
  border-radius: 14rpx;
  background: rgba(147, 112, 219, .14);
  border: 1rpx solid rgba(147, 112, 219, .3);
  display: flex;
  align-items: center;
  justify-content: center;
}
.now-ico { width: 44rpx; height: 44rpx; display: block; }
.now-btn-press .now-btn-inner { background: rgba(147, 112, 219, .28); }

/* DF-82：数字起卦「随机」按钮（可见 66rpx 与输入框对齐，热区高度 ≥88rpx，不与输入框重叠） */
.rand-btn { flex: 0 0 auto; padding: 11rpx 0; margin: -11rpx 0; }
.rand-btn-inner {
  height: 66rpx;
  line-height: 66rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #cbb6ee;
  text-align: center;
  white-space: nowrap;
  background: rgba(147, 112, 219, .14);
  border: 1rpx solid rgba(147, 112, 219, .3);
}
.rand-btn-press .rand-btn-inner { background: rgba(147, 112, 219, .28); }

.num-tip { font-size: 22rpx; color: #8f7cb0; margin-top: 10rpx; }

.cond-actions { display: flex; justify-content: flex-end; margin-bottom: 20rpx; }
.cond-actions .qm-btn { width: 200rpx; height: 68rpx; }

/* 三卦 */
.hexes { display: flex; margin-bottom: 8rpx; }

.hex {
  flex: 1;
  margin-right: 12rpx;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  text-align: center;
  background: rgba(30, 18, 54, .82);
  border: 1rpx solid rgba(147, 112, 219, .26);
}

.hex:last-child { margin-right: 0; }

.hex-title { font-size: 22rpx; color: #8f7cb0; margin-bottom: 10rpx; }

.hex-lines { display: flex; flex-direction: column; align-items: center; }

.hline { width: 100%; display: flex; justify-content: center; margin-bottom: 6rpx; }

.yao { display: flex; align-items: center; width: 128rpx; }

.bar {
  flex: 1;
  height: 14rpx;
  border-radius: 4rpx;
  background: #cdbce8;
}

.bar-half { flex: 1; }

.bar-gap { width: 22rpx; }

.bar-mark { background: linear-gradient(90deg, #e8b84a, #ff8fb5); box-shadow: 0 0 10rpx rgba(232, 184, 74, .7); }

.hex-name { font-size: 24rpx; color: #efe6ff; margin-top: 8rpx; }
.hex-sub { font-size: 20rpx; color: #8f7cb0; }

.tip { font-size: 22rpx; color: #8f7cb0; margin: 12rpx 0; }

/* 体用 */
.qinfo {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(147, 112, 219, .10);
  border: 1rpx solid rgba(147, 112, 219, .25);
  margin-bottom: 20rpx;
}

.qinfo-row { display: flex; align-items: center; flex-wrap: wrap; margin-bottom: 8rpx; }
.qinfo-row:last-child { margin-bottom: 0; }

.qinfo-label { font-size: 22rpx; color: #9f8ac0; margin-right: 10rpx; }
.qinfo-val { font-size: 24rpx; color: #e3d9f0; margin-right: 16rpx; }

.badge {
  font-size: 20rpx;
  color: #e8b84a;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(232, 184, 74, .12);
  border: 1rpx solid rgba(232, 184, 74, .3);
}

.actions { display: flex; }
.actions .qm-btn { flex: 1; margin-right: 16rpx; }
.actions .qm-btn:last-child { margin-right: 0; }

.empty { padding: 100rpx 20rpx; text-align: center; font-size: 26rpx; color: #8f7cb0; }

.hint-scroll { max-height: 56vh; margin-bottom: 14rpx; }
.hint-text { font-size: 24rpx; color: #c9bce2; line-height: 1.72; white-space: pre-wrap; }
