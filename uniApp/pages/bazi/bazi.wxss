.page { padding: 20rpx 24rpx 40rpx; }

.cond {
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, .05);
  border: 1rpx solid rgba(147, 112, 219, .25);
  margin-bottom: 18rpx;
}

.cond-row { display: flex; align-items: center; margin-bottom: 14rpx; }

.cond-label { width: 80rpx; font-size: 24rpx; color: #9f8ac0; }

.picker { flex: 1; margin-right: 14rpx; }
.picker:last-child { margin-right: 0; }

.pick-val {
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #e8dff5;
  background: rgba(147, 112, 219, .14);
  border: 1rpx solid rgba(147, 112, 219, .3);
}

.name-input {
  flex: 1;
  height: 68rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #e8dff5;
  background: rgba(147, 112, 219, .14);
  border: 1rpx solid rgba(147, 112, 219, .3);
}

.ph { color: #7d6b9c; }

.cond-actions { display: flex; justify-content: flex-end; }
.cond-actions .qm-btn { width: 180rpx; height: 66rpx; margin-left: 16rpx; }

/* 四柱 */
.pillars { display: flex; margin-bottom: 14rpx; }

.pillar {
  flex: 1;
  margin-right: 10rpx;
  padding: 14rpx 6rpx;
  border-radius: 14rpx;
  text-align: center;
  background: rgba(30, 18, 54, .82);
  border: 1rpx solid rgba(147, 112, 219, .26);
}

.pillar:last-child { margin-right: 0; }

.p-name { font-size: 20rpx; color: #8f7cb0; margin-bottom: 6rpx; }
.p-god { font-size: 20rpx; color: #b9a8d6; height: 28rpx; }
.p-god-b { margin-top: 4rpx; }
.p-gan { font-size: 46rpx; font-weight: 700; line-height: 1.2; }
.p-zhi { font-size: 46rpx; font-weight: 700; line-height: 1.2; }
.p-wx { font-size: 20rpx; color: #8f7cb0; margin-top: 6rpx; }

.meta { display: flex; flex-wrap: wrap; margin-bottom: 16rpx; }

.meta-item {
  font-size: 22rpx;
  color: #a692c4;
  margin-right: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, .05);
}

/* 旺衰 */
.qinfo {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(147, 112, 219, .10);
  border: 1rpx solid rgba(147, 112, 219, .25);
  margin-bottom: 20rpx;
}

.qinfo-row { display: flex; align-items: center; flex-wrap: wrap; margin-bottom: 8rpx; }

.qinfo-label { font-size: 22rpx; color: #9f8ac0; margin-right: 10rpx; }

.qinfo-val { font-size: 24rpx; color: #e3d9f0; margin-right: 12rpx; }

.badge {
  font-size: 20rpx;
  color: #e8b84a;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(232, 184, 74, .12);
  border: 1rpx solid rgba(232, 184, 74, .3);
}

.prof-text { margin-top: 10rpx; font-size: 24rpx; color: #b9a8d6; line-height: 1.75; }

/* 大运 */
.section-title { font-size: 24rpx; color: #cdbce8; margin: 6rpx 0 12rpx; }

.dayun-scroll { width: 100%; white-space: nowrap; }

.dayun-list { display: flex; padding-bottom: 6rpx; }

.dayun {
  flex: 0 0 auto;
  width: 150rpx;
  margin-right: 12rpx;
  padding: 14rpx 8rpx;
  border-radius: 14rpx;
  text-align: center;
  background: rgba(30, 18, 54, .82);
  border: 1rpx solid rgba(147, 112, 219, .22);
}

.dayun-cur { border-color: #e8b84a; background: rgba(232, 184, 74, .10); }

.dy-gz { font-size: 32rpx; font-weight: 700; color: #efe6ff; }
.dy-age { font-size: 20rpx; color: #a692c4; margin-top: 4rpx; }
.dy-year { font-size: 20rpx; color: #7d6b9c; }
.dy-t { font-size: 20rpx; margin-top: 6rpx; }
.t-up { color: #7fd4a0; }
.t-down { color: #ff8fb5; }
.t-flat { color: #b9a8d6; }

.tip { font-size: 22rpx; color: #8f7cb0; margin: 16rpx 0; line-height: 1.6; }

.actions { display: flex; }

.actions .qm-btn { flex: 1; margin-right: 16rpx; }
.actions .qm-btn:last-child { margin-right: 0; }

.empty { padding: 100rpx 20rpx; text-align: center; font-size: 26rpx; color: #8f7cb0; }

.hint-scroll { max-height: 56vh; margin-bottom: 14rpx; }
.hint-text { font-size: 24rpx; color: #c9bce2; line-height: 1.72; white-space: pre-wrap; }
