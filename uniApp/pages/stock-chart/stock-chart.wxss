/* 全屏图表页由 web-view 铺满，页面本身不设样式 */
page {
  background: #fffdf7;
}

/* 业务域名未配置时的降级提示层 */
.chart-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 0 64rpx;
  box-sizing: border-box;
  text-align: center;
}
.cf-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1029;
  margin-bottom: 20rpx;
}
.cf-desc {
  font-size: 26rpx;
  line-height: 1.6;
  color: #6a5a85;
  margin-bottom: 40rpx;
}
.cf-btn {
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
  background: #1a1029;
  color: #ffffff;
  font-size: 28rpx;
}
.cf-btn-press {
  opacity: .8;
}
