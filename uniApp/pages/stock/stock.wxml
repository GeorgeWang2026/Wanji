<!-- ============================================================
     证券详情（原生页，DF-99）
     参照物：网站 static/xiaoxuan.html 证券详情页
       ① 信息区（#stockDetailInfo）：股票/涨跌幅/方向/级别/结构/态势/空间/行业
       ② K 线区（kline.html simple 模式）：只做日 K，方形、满宽、无左右横向内边距
       ③ 底部工具栏（预览提示词 / 关联到提问）：保持原样，不改动不重排
     ============================================================ -->
<view class="page">

  <!-- ① 信息区 -->
  <view class="stock-info">
    <text class="si-hint" wx:if="{{infoStatus === 'loading'}}">行情加载中…</text>
    <text class="si-hint" wx:elif="{{infoStatus === 'empty' || !info}}">暂无该证券详情数据</text>
    <block wx:else>
      <view class="si-item">
        <text class="si-l">股票</text>
        <text class="si-name">{{info.name}}</text>
        <text class="si-badge" wx:if="{{info.credit}}" style="background:{{info.creditBg}};">{{info.credit}}</text>
      </view>
      <view class="si-item">
        <text class="si-l">涨跌幅</text>
        <text class="si-b" style="color:{{info.zdfColor}};">{{info.zdfText}}</text>
      </view>
      <view class="si-item">
        <text class="si-l">方向</text>
        <text class="si-b">{{info.dirText}}</text>
      </view>
      <view class="si-item" wx:if="{{info.grade}}">
        <text class="si-l">级别</text>
        <text class="si-b">{{info.grade}}</text>
      </view>
      <view class="si-item">
        <text class="si-l">结构</text>
        <text class="si-badge" wx:for="{{info.structs}}" wx:key="index" style="background:{{item.bg}};">{{item.t}}</text>
      </view>
      <view class="si-item">
        <text class="si-l">态势</text>
        <text class="si-badge" wx:for="{{info.trend}}" wx:key="index" style="background:{{item.bg}};">{{item.t}}</text>
      </view>
      <view class="si-item">
        <text class="si-l">空间</text>
        <text class="si-space">{{info.space}}</text>
      </view>
      <view class="si-item" wx:if="{{info.industry}}">
        <text class="si-l">行业</text>
        <text class="si-b">{{info.industry}}</text>
      </view>
    </block>
  </view>

  <!-- ② K 线区 -->
  <view class="chart-wrap">
    <canvas
      type="2d"
      id="kline"
      class="chart"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
      bindtouchcancel="onTouchEnd"
    ></canvas>

    <view class="chart-tip {{status === 'error' ? 'err' : ''}}" wx:if="{{status !== 'ready'}}">{{chartTip}}</view>
  </view>

  <!-- ③ 底部工具栏：内容滚动时始终贴底不动（底部安全区已在 .bottom-bar 内计入） -->
  <view class="bottom-bar" wx:if="{{!showHint && code}}">
    <view class="qm-btn qm-btn-ghost" bindtap="previewPrompt">预览提示词</view>
    <view class="qm-btn qm-btn-primary" bindtap="onBind">关联到提问</view>
  </view>

  <!-- 提示词预览：全文展示，不截断 -->
  <view class="qm-mask" wx:if="{{showHint}}" catchtap="closeHint">
    <view class="qm-dialog" catchtap="noop">
      <view class="qm-dialog-title">关联后后端将使用的盘面提示词</view>
      <scroll-view scroll-y class="hint-scroll">
        <text class="hint-text">{{hint}}</text>
      </scroll-view>
      <view class="dialog-actions">
        <view class="qm-btn qm-btn-primary" bindtap="closeHint">关闭</view>
      </view>
    </view>
  </view>
</view>
