<!-- ============================================================
     证券行情（原生页）
     - 顶部：最新价 + 涨跌 + 今开/最高/最低/昨收/量/额
     - 中部：代码查询 + 常用股票快捷切换
     - 底部：日/周/月 K 线（canvas 2d）+ 三态遮罩
     ============================================================ -->
<view class="page">

  <!-- 行情头部 -->
  <view class="hero">
    <view class="hero-top">
      <text class="q-name">{{name || '证券行情'}}</text>
      <text class="q-code">{{code}}</text>
    </view>

    <view class="q-price-row">
      <text class="q-price {{colorClass}}">{{priceText}}</text>
      <text class="q-chg {{colorClass}}">{{changeText}}</text>
      <text class="q-chg {{colorClass}}">{{pctText}}</text>
    </view>

    <view class="q-grid">
      <view class="qg" wx:for="{{quoteRows}}" wx:key="k">
        <text class="qg-l">{{item.k}}</text>
        <text class="qg-v">{{item.v}}</text>
      </view>
    </view>
  </view>

  <!-- 代码查询 -->
  <view class="search">
    <input
      class="search-input"
      type="number"
      maxlength="6"
      value="{{codeInput}}"
      placeholder="输入 6 位股票代码，如 600519"
      placeholder-class="ph"
      bindinput="onCodeInput"
      bindconfirm="onSearch"
    />
    <view class="search-btn" hover-class="press" bindtap="onSearch">查询</view>
  </view>

  <scroll-view class="presets" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}">
    <view
      class="preset {{code === item.code ? 'on' : ''}}"
      wx:for="{{presets}}"
      wx:key="code"
      bindtap="onPreset"
      data-code="{{item.code}}"
    >{{item.name}} {{item.code}}</view>
  </scroll-view>

  <!-- 周期切换 -->
  <view class="tabs">
    <view
      class="tab {{period === item.k ? 'on' : ''}}"
      wx:for="{{periods}}"
      wx:key="k"
      bindtap="onPeriod"
      data-k="{{item.k}}"
    >{{item.t}}</view>
  </view>

  <!-- K 线 -->
  <view class="chart-wrap">
    <canvas
      type="2d"
      id="kline"
      class="chart"
      bindtouchstart="onTouch"
      bindtouchmove="onTouch"
      bindtouchend="onTouchEnd"
      bindtouchcancel="onTouchEnd"
    ></canvas>

    <view class="chart-mask" wx:if="{{status === 'loading'}}">
      <view class="spinner"></view>
      <text class="mask-txt">正在拉取行情…</text>
    </view>

    <view class="chart-mask" wx:elif="{{status === 'empty'}}">
      <text class="mask-txt">该周期暂无 K 线数据</text>
      <text class="mask-sub">可能是新上市、停牌或代码不在沪深市场</text>
    </view>

    <view class="chart-mask err" wx:elif="{{status === 'error'}}" bindtap="onRetry">
      <text class="mask-txt">行情加载失败</text>
      <text class="mask-sub">{{errMsg}}</text>
      <view class="err-btn">点击重试</view>
    </view>
  </view>

  <!-- 十字线数据 -->
  <view class="cursor" wx:if="{{cursorText}}">{{cursorText}}</view>
  <view class="ma-line" wx:if="{{status === 'ready'}}">{{maText}}</view>

  <view class="foot">
    <text>数据来源：东方财富公开行情接口，仅供参考，不构成投资建议。</text>
    <text class="foot-dim" wx:if="{{status === 'error'}}">
      若提示「域名未加白名单」：小程序后台 → 开发管理 → 服务器域名 → request 合法域名，添加 push2.eastmoney.com 与 push2his.eastmoney.com；开发者工具里也可临时勾选「不校验合法域名」。
    </text>
  </view>
</view>
