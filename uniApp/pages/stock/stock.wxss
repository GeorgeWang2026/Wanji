/* ============================================================
 * 证券详情页样式（DF-99）
 * 参照：网站 static/xiaoxuan.html 证券详情页（深色模态框）
 *       + static/mystock/kline.html（浅色 K 线区 #fffdf7）
 * 说明：小程序 WXSS 无 * / 属性选择器 / :active，
 *       按压态统一用 hover-class="press"。
 * ============================================================ */
.page {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  background: linear-gradient(160deg, #2a1a48 0%, #1e1033 100%);
  box-sizing: border-box;
}

/* ---------- ① 信息区（对齐 .stock-info） ---------- */
.stock-info {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
  padding: 24rpx 24rpx 20rpx;
  border-bottom: 1rpx solid rgba(147, 112, 219, .18);
  background: linear-gradient(135deg, rgba(60, 150, 120, .14), rgba(40, 110, 160, .10));
}

.si-hint {
  font-size: 22rpx;
  line-height: 1.6;
  color: #8a75b0;
}

.si-item {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #b8a5d5;
  line-height: 1.5;
}

.si-l { color: #8a75b0; }

.si-b {
  color: #e8dff5;
  font-weight: 600;
}

.si-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.si-space { color: #e8dff5; }

.si-badge {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #fff;
  white-space: nowrap;
}

/* 方形占位：尺寸与上一轮 K 线区一致（750rpx，满宽），浅色主题 */
.chart-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 750rpx;
  background: #fffdf7;
  border-bottom: 1rpx solid rgba(147, 112, 219, .25);
}

.chart-press { background: #f7f1e2; }

.chart-ph {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 520rpx;
  padding: 56rpx 24rpx;
  border: 2rpx dashed #d9cdb0;
  border-radius: 16rpx;
  background: #fff;
}

.chart-ph-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #6b5b3e;
}

.chart-ph-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a7a5f;
}

.chart-ph-btn {
  margin-top: 28rpx;
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  background: #c9a227;
  color: #fff;
  font-size: 26rpx;
  line-height: 1.5;
}

/* ---------- 提示词预览 ---------- */
.hint-scroll { max-height: 56vh; margin-bottom: 14rpx; }
.hint-text { font-size: 24rpx; line-height: 1.7; color: #d9cbef; white-space: pre-wrap; }
