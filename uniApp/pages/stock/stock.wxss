/* ============================================================
 * 证券行情页样式（沿用全局暗紫金主题）
 * 说明：小程序 WXSS 无 * / 属性选择器 / :active，
 *       按压态统一用 hover-class="press"。
 * ============================================================ */
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  background: linear-gradient(160deg, #1e1033 0%, #2d1b4e 40%, #1a0f2e 100%);
  box-sizing: border-box;
}

/* ---------- 行情头部 ---------- */
.hero {
  background: rgba(255, 255, 255, .05);
  border: 1rpx solid rgba(147, 112, 219, .28);
  border-radius: 24rpx;
  padding: 24rpx 26rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, .28);
}

.hero-top {
  display: flex;
  align-items: baseline;
}

.q-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #f0e9ff;
}

.q-code {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: #9f8ac0;
  letter-spacing: 1rpx;
}

.q-price-row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.q-price {
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.1;
}

.q-chg {
  margin-left: 16rpx;
  font-size: 26rpx;
}

.up { color: #ff6478; }
.down { color: #50c88c; }
.flat { color: #e8e0f0; }

.q-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.qg {
  width: 33.33%;
  font-size: 22rpx;
  line-height: 1.9;
  color: #d8ccec;
}

.qg-l {
  color: #9f8ac0;
  margin-right: 8rpx;
}

/* ---------- 代码查询 ---------- */
.search {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 38rpx;
  background: rgba(255, 255, 255, .06);
  border: 1rpx solid rgba(147, 112, 219, .3);
  color: #e8e0f0;
  font-size: 26rpx;
}

.ph { color: #6f5f8f; }

.search-btn {
  width: 140rpx;
  height: 76rpx;
  margin-left: 16rpx;
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #fff;
  background: linear-gradient(135deg, #9370db, #b088e0);
  box-shadow: 0 8rpx 22rpx rgba(147, 112, 219, .35);
}

.press { opacity: .72; }

/* ---------- 常用股票 ---------- */
.presets {
  margin-top: 18rpx;
  white-space: nowrap;
  height: 60rpx;
}

.preset {
  display: inline-block;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 22rpx;
  margin-right: 12rpx;
  border-radius: 28rpx;
  font-size: 22rpx;
  color: #b8a5d5;
  background: rgba(255, 255, 255, .05);
  border: 1rpx solid rgba(147, 112, 219, .25);
}

.preset.on {
  color: #fff;
  background: rgba(147, 112, 219, .45);
  border-color: rgba(176, 136, 224, .7);
}

/* ---------- 周期切换 ---------- */
.tabs {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.tab {
  padding: 10rpx 26rpx;
  margin-right: 12rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #b8a5d5;
  border: 1rpx solid rgba(147, 112, 219, .3);
}

.tab.on {
  color: #fff;
  background: rgba(147, 112, 219, .5);
  border-color: rgba(176, 136, 224, .75);
}

/* ---------- K 线画布 ---------- */
.chart-wrap {
  position: relative;
  margin-top: 18rpx;
  height: 640rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, .2);
  border: 1rpx solid rgba(147, 112, 219, .22);
  overflow: hidden;
}

.chart {
  width: 100%;
  height: 100%;
  display: block;
}

/* 三态遮罩：加载 / 无数据 / 失败 */
.chart-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(20, 10, 40, .55);
  padding: 0 40rpx;
}

.mask-txt {
  font-size: 26rpx;
  color: #c8b8e8;
}

.mask-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #8f7db3;
  text-align: center;
}

.spinner {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 18rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(147, 112, 219, .25);
  border-top-color: #b088e0;
  animation: spin .9s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.err-btn {
  margin-top: 22rpx;
  padding: 12rpx 40rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #d9c8ff;
  border: 1rpx solid rgba(176, 136, 224, .7);
  background: rgba(147, 112, 219, .18);
}

/* ---------- 十字线 / 均线 ---------- */
.cursor {
  margin-top: 14rpx;
  padding: 12rpx 18rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #d8ccec;
  background: rgba(147, 112, 219, .12);
  border: 1rpx solid rgba(147, 112, 219, .2);
}

.ma-line {
  margin-top: 14rpx;
  font-size: 20rpx;
  color: #9f8ac0;
  letter-spacing: 1rpx;
}

/* ---------- 页脚 ---------- */
.foot {
  margin-top: 26rpx;
  font-size: 20rpx;
  line-height: 1.8;
  color: #6f5f8f;
}

.foot-dim {
  display: block;
  margin-top: 10rpx;
  color: #7d6b9d;
}
