/* DF-156 · 问卷 demo 样式
   颜色一律取 app.wxss 的 --qm-* 主题变量，禁止硬编码；
   按钮复用全局 .qm-btn / .qm-btn-primary。 */

.sv-page {
  padding: 24rpx 24rpx 64rpx;
}

.sv-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--qm-text-strong);
}

.sv-intro {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--qm-muted);
}

.sv-progress {
  margin-top: 14rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--qm-muted);
}

.sv-progress-bar {
  flex: 1 1 auto;
  height: 8rpx;
  margin-left: 16rpx;
  border-radius: 4rpx;
  background: var(--qm-line);
  overflow: hidden;
}

.sv-progress-text {
  flex: 0 0 auto;
  font-size: 22rpx;
  color: var(--qm-muted);
}

.sv-progress-inner {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, var(--qm-accent), var(--qm-accent-2));
}

.sv-q {
  margin-top: 24rpx;
  padding: 20rpx 0 8rpx;
  border-top: 1rpx solid var(--qm-line);
}

.sv-q-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
}

.sv-q-index {
  margin-right: 8rpx;
  font-size: 28rpx;
  color: var(--qm-text-soft);
}

.sv-q-title {
  font-size: 28rpx;
  color: var(--qm-text);
  font-weight: 500;
}

.sv-req {
  margin-left: 10rpx;
  padding: 0 10rpx;
  font-size: 20rpx;
  line-height: 32rpx;
  color: var(--qm-gold);
  border: 1rpx solid var(--qm-gold-border);
  border-radius: 8rpx;
}

.sv-type {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--qm-muted);
}

.sv-opts {
  margin-top: 12rpx;
  background: var(--qm-card-bg-soft);
  border: 1rpx solid var(--qm-card-border);
  border-radius: var(--qm-radius-sm);
  padding: 4rpx 0;
}

.sv-opt {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 18rpx 22rpx;
  border-top: 1rpx solid var(--qm-line-soft);
}

.sv-opt:first-child {
  border-top: 0;
}

.sv-opt-on {
  background: var(--qm-chip-bg);
}

.sv-mark {
  width: 28rpx;
  height: 28rpx;
  margin-top: 6rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  border: 2rpx solid var(--qm-accent-line);
  flex: 0 0 auto;
  box-sizing: border-box;
}

.sv-mark-square {
  border-radius: 6rpx;
}

.sv-mark-on {
  border-color: transparent;
  background: linear-gradient(135deg, var(--qm-accent), var(--qm-accent-2));
}

.sv-opt-body {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
}

.sv-opt-label {
  font-size: 28rpx;
  color: var(--qm-text);
}

.sv-opt-skip {
  color: var(--qm-muted);
}

.sv-note {
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--qm-text-soft);
  background: var(--qm-chip-bg);
  border: 1rpx solid var(--qm-card-border);
  border-radius: var(--qm-radius-sm);
}

.sv-hint {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--qm-warn);
  background: var(--qm-warn-bg);
  border: 1rpx solid var(--qm-warn-border);
  border-radius: var(--qm-radius-sm);
}

.sv-actions {
  margin-top: 26rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.sv-actions .qm-btn {
  flex: 1 1 auto;
  min-width: 200rpx;
  margin: 0 14rpx 14rpx 0;
  padding: 0 30rpx;
}

.sv-actions .qm-btn:last-child {
  margin-right: 0;
}

.sv-btn-busy {
  opacity: .55;
}

.sv-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--qm-muted);
  word-break: break-all;
}

.sv-result {
  margin-top: 20rpx;
}

.sv-result-title {
  font-size: 26rpx;
  color: var(--qm-text-soft);
}

.sv-json {
  margin-top: 10rpx;
  max-height: 480rpx;
  padding: 16rpx 20rpx;
  background: var(--qm-json-bg);
  border: 1rpx solid var(--qm-card-border);
  border-radius: var(--qm-radius-sm);
}

.sv-json-text {
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--qm-text-soft);
  white-space: pre-wrap;
  word-break: break-all;
}
