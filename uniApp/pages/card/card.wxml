<!-- ============================================================
     DF-156 · 卡片渲染器模板
     8 个原子组件 = 8 个编译期固化的 template，渲染器只做 type 映射。
     契约见 wanji static/cards/samples/manifest.json：
       group / text / buttons / choice / input / image / status / notice
     未知 type 在 card-layout.js 已归一：有文本→text，无文本→丢弃。
     ============================================================ -->

<!-- 1. 文本块 -->
<template name="t-text">
  <view class="cx-text {{item.tone === 'muted' ? 'cx-muted' : ''}}">{{item.text}}</view>
</template>

<!-- 2. 分组容器（子节点已在解析层按 depth 展开） -->
<template name="t-group">
  <view class="cx-group">
    <view wx:if="{{item.title}}" class="cx-group-title">{{item.title}}</view>
  </view>
</template>

<!-- 3. 按键组 -->
<template name="t-buttons">
  <view class="cx-btns">
    <view
      wx:for="{{item.items}}"
      wx:key="action_id"
      class="cx-btn {{item.style === 'primary' ? 'cx-btn-primary' : ''}}"
      data-action-id="{{item.action_id}}"
      bindtap="onTapAction"
    >{{item.label}}</view>
  </view>
</template>

<!-- 4. 单选/多选列表 -->
<template name="t-choice">
  <view class="cx-choice">
    <view
      wx:for="{{item.options}}"
      wx:for-item="opt"
      wx:key="action_id"
      class="cx-item"
      data-action-id="{{opt.action_id}}"
      bindtap="onTapAction"
    >
      <view class="cx-mark {{item.multiple ? 'cx-mark-square' : ''}}"></view>
      <view class="cx-item-body">
        <view class="cx-item-label">{{opt.label}}</view>
        <view wx:if="{{opt.description}}" class="cx-item-desc">{{opt.description}}</view>
      </view>
    </view>
  </view>
</template>

<!-- 5. 输入框 -->
<template name="t-input">
  <view class="cx-field">
    <input
      class="cx-input"
      value="{{item.value}}"
      placeholder="{{item.placeholder}}"
      maxlength="{{item.max_length}}"
      data-key="{{item.key}}"
      bindinput="onInputChange"
    />
  </view>
</template>

<!-- 6. 图片 -->
<template name="t-image">
  <view class="cx-image-wrap">
    <image class="cx-image" src="{{item.url}}" mode="aspectFill" />
    <view wx:if="{{item.alt}}" class="cx-image-alt">{{item.alt}}</view>
  </view>
</template>

<!-- 7. 状态/进度 -->
<template name="t-status">
  <view class="cx-status">
    <view class="cx-status-head">
      <text class="cx-status-label">{{item.label}}</text>
      <text class="cx-status-value">{{item.text}}</text>
    </view>
    <view class="cx-bar">
      <view class="cx-bar-inner" style="width: {{item.value}}%"></view>
    </view>
  </view>
</template>

<!-- 8. 提示条 -->
<template name="t-notice">
  <view class="cx-notice cx-notice-{{item.level}}">{{item.text}}</view>
</template>

<view class="cx-page">
  <!-- 无 card 字段：旧纯文本消息，不画卡 -->
  <view wx:if="{{status === 'skipped'}}" class="cx-block">
    <view class="cx-notice cx-notice-info">本条消息无 card 字段，按纯文本渲染（旧消息不受影响）</view>
  </view>

  <!-- 整卡被拒 -->
  <view wx:elif="{{status === 'rejected'}}" class="cx-block">
    <view class="cx-notice cx-notice-error">{{message}}</view>
    <view class="cx-btn cx-btn-primary cx-retry" bindtap="onRetry">重试</view>
  </view>

  <!-- 解析异常 -->
  <view wx:elif="{{status === 'error'}}" class="cx-block">
    <view class="cx-notice cx-notice-error">{{message}}</view>
  </view>

  <!-- 正常渲染 -->
  <view wx:else class="cx-block">
    <view wx:if="{{notice}}" class="cx-notice cx-notice-warn">{{notice}}</view>

    <view
      wx:for="{{nodes}}"
      wx:key="index"
      class="cx-node"
      style="margin-left: {{item.depth * 16}}rpx"
    >
      <template is="t-{{item.type}}" data="{{item: item}}" />
    </view>

    <view class="cx-foot" wx:if="{{meta}}">
      {{meta.card_id}} · schema {{meta.schema_version}} · {{stats.count}} 节点 · {{costMs}}ms
    </view>
  </view>
</view>
