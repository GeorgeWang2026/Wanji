/* DF-156 · 卡片页样式（沿用全局暗紫底，只加卡片内部排版） */

.cx-page {
  padding: 24rpx;
}

.cx-block {
  display: flex;
  flex-direction: column;
}

.cx-node {
  margin-top: 16rpx;
}

/* 文本块 */
.cx-text {
  font-size: 28rpx;
  color: #e8e0f0;
  line-height: 1.7;
  word-break: break-all;
}

.cx-muted {
  color: rgba(232, 224, 240, .62);
}

/* 按键组 */
.cx-btns {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.cx-btn {
  flex: 1 1 auto;
  min-width: 200rpx;
  margin: 8rpx 8rpx 8rpx 0;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  color: #efe6ff;
  background: rgba(255, 255, 255, .08);
  border: 1rpx solid rgba(147, 112, 219, .38);
  border-radius: 36rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cx-btn-primary {
  color: #fff;
  background: linear-gradient(135deg, #9370db, #ff8fb5);
  border-color: transparent;
}

/* 选择列表 */
.cx-choice {
  background: rgba(255, 255, 255, .04);
  border: 1rpx solid rgba(147, 112, 219, .22);
  border-radius: 18rpx;
  padding: 8rpx 0;
}

.cx-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 18rpx 22rpx;
  border-top: 1rpx solid rgba(147, 112, 219, .12);
}

.cx-item:first-child {
  border-top: 0;
}

.cx-mark {
  width: 28rpx;
  height: 28rpx;
  margin-top: 6rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(147, 112, 219, .6);
  flex: 0 0 auto;
}

.cx-mark-square {
  border-radius: 6rpx;
}

.cx-item-body {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
}

.cx-item-label {
  font-size: 28rpx;
  color: #e8e0f0;
}

.cx-item-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(232, 224, 240, .55);
  line-height: 1.5;
}

/* 输入框 */
.cx-field {
  display: flex;
  flex-direction: column;
}

.cx-input {
  height: 76rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
  color: #e8e0f0;
  background: rgba(255, 255, 255, .06);
  border: 1rpx solid rgba(147, 112, 219, .3);
  border-radius: 16rpx;
}

/* 图片 */
.cx-image-wrap {
  border-radius: 16rpx;
  overflow: hidden;
}

.cx-image {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, .05);
}

.cx-image-alt {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(232, 224, 240, .55);
}

/* 状态/进度 */
.cx-status-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  font-size: 26rpx;
  color: #e8e0f0;
}

.cx-status-value {
  color: #ff8fb5;
}

.cx-bar {
  margin-top: 10rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, .1);
  overflow: hidden;
}

.cx-bar-inner {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #9370db, #ff8fb5);
}

/* 分组容器 */
.cx-group {
  padding-left: 14rpx;
  border-left: 4rpx solid rgba(147, 112, 219, .5);
}

.cx-group-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #cdb8f0;
  margin-bottom: 6rpx;
}

/* 提示条 */
.cx-notice {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.cx-notice-info {
  color: #cdb8f0;
  background: rgba(147, 112, 219, .16);
  border: 1rpx solid rgba(147, 112, 219, .32);
}

.cx-notice-warn {
  color: #ffd08a;
  background: rgba(255, 176, 60, .12);
  border: 1rpx solid rgba(255, 176, 60, .3);
}

.cx-notice-error {
  color: #ffb3b3;
  background: rgba(255, 96, 96, .12);
  border: 1rpx solid rgba(255, 96, 96, .32);
}

.cx-retry {
  margin-top: 20rpx;
  align-self: flex-start;
}

.cx-foot {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(232, 224, 240, .45);
}
