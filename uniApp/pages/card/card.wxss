/* ============================================================
 * DF-156 · 卡片页样式
 * 颜色一律取 app.wxss 的 --qm-* 主题变量，禁止硬编码（§15.3）；
 * 按键复用全局 .qm-btn / .qm-btn-primary，本文件只管排版。
 * ============================================================ */

.cx-page {
  padding: 24rpx;
}

.cx-block {
  display: flex;
  flex-direction: column;
}

.cx-node {
  margin-top: 16rpx;
}

/* 文本块 */
.cx-text {
  font-size: 28rpx;
  color: var(--qm-text);
  line-height: 1.7;
  word-break: break-all;
}

.cx-muted {
  color: var(--qm-muted);
}

/* 按键组（外观走 .qm-btn，此处只控排布） */
.cx-btns {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.cx-btn {
  flex: 1 1 auto;
  min-width: 200rpx;
  margin: 8rpx 8rpx 8rpx 0;
  padding: 0 28rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 选择列表 */
.cx-choice {
  background: var(--qm-card-bg-soft);
  border: 1rpx solid var(--qm-card-border);
  border-radius: var(--qm-radius-sm);
  padding: 8rpx 0;
}

.cx-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 18rpx 22rpx;
  border-top: 1rpx solid var(--qm-line-soft);
}

.cx-item:first-child {
  border-top: 0;
}

.cx-mark {
  width: 28rpx;
  height: 28rpx;
  margin-top: 6rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  border: 2rpx solid var(--qm-accent-line);
  flex: 0 0 auto;
  box-sizing: border-box;
}

.cx-mark-square {
  border-radius: 6rpx;
}

.cx-item-body {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
}

.cx-item-label {
  font-size: 28rpx;
  color: var(--qm-text);
}

.cx-item-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--qm-muted);
  line-height: 1.5;
}

/* 表单（只读预览） */
.cx-form-q {
  margin-top: 16rpx;
}

.cx-form-q-title {
  font-size: 28rpx;
  color: var(--qm-text);
  font-weight: 500;
}

.cx-form-req {
  margin-left: 10rpx;
  padding: 0 10rpx;
  font-size: 20rpx;
  line-height: 32rpx;
  color: var(--qm-gold);
  border: 1rpx solid var(--qm-gold-border);
  border-radius: 8rpx;
}

/* 输入框 */
.cx-field {
  display: flex;
  flex-direction: column;
}

.cx-input {
  height: 76rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
  color: var(--qm-text);
  background: var(--qm-card-bg);
  border: 1rpx solid var(--qm-card-border);
  border-radius: var(--qm-radius-sm);
}

/* 图片 */
.cx-image-wrap {
  border-radius: var(--qm-radius-sm);
  overflow: hidden;
}

.cx-image {
  width: 100%;
  height: 320rpx;
  border-radius: var(--qm-radius-sm);
  background: var(--qm-card-bg);
}

.cx-image-alt {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--qm-muted);
}

/* 状态/进度 */
.cx-status-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  font-size: 26rpx;
  color: var(--qm-text);
}

.cx-status-value {
  color: var(--qm-accent-2);
}

.cx-bar {
  margin-top: 10rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--qm-line);
  overflow: hidden;
}

.cx-bar-inner {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, var(--qm-accent), var(--qm-accent-2));
}

/* 分组容器 */
.cx-group {
  padding-left: 14rpx;
  border-left: 4rpx solid var(--qm-accent-line);
}

.cx-group-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--qm-text-soft);
  margin-bottom: 6rpx;
}

/* 提示条 */
.cx-notice {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--qm-radius-sm);
  font-size: 26rpx;
  line-height: 1.6;
}

.cx-notice-info {
  color: var(--qm-text-soft);
  background: var(--qm-chip-bg);
  border: 1rpx solid var(--qm-card-border);
}

.cx-notice-warn {
  color: var(--qm-warn);
  background: var(--qm-warn-bg);
  border: 1rpx solid var(--qm-warn-border);
}

.cx-notice-error {
  color: var(--qm-danger);
  background: var(--qm-danger-bg);
  border: 1rpx solid var(--qm-danger-border);
}

.cx-retry {
  margin-top: 20rpx;
  align-self: flex-start;
  min-width: 220rpx;
  padding: 0 32rpx;
}

.cx-foot {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--qm-muted);
}
