# ============================================================
# 万机 · 玄机智能助手（微信小程序） .gitignore
# 原则：只入库小程序源码与工程配置，产物 / 本地配置 / 截图 / 密钥一律不入库
# ============================================================

# --- 微信开发者工具 / 构建产物 ---
node_modules/
miniprogram_npm/
unpackage/
dist/
build/
*.log

# 开发者工具本地私有配置（含本机调试条件、编译设置，因人而异）
project.private.config.json

# --- 截图、本地比对与临时工作产物 ---
.screenshots/
.trae-html-share-packages/
2026-11-11/
*.zip
*.png
*.jpg
*.jpeg

# --- 密钥与凭据 ---
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
private.*.key
id_rsa*

# --- 系统 / 编辑器 ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
