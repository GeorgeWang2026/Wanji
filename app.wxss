/* ============================================================
 * 全局样式（暗色紫金主题，取自 xiaoxuan.html 的视觉基调）
 * 只作用于小程序；网页版样式仍在 xiaoxuan.html 内联 <style> 里，互不影响。
 * ============================================================ */
/* ---------- DF-156：主题变量（卡片/问卷复用，禁止再写死颜色） ---------- */
page {
  --qm-bg-start: #1e1033;
  --qm-bg-mid: #2d1b4e;
  --qm-bg-end: #1a0f2e;
  --qm-text: #e8e0f0;
  --qm-text-strong: #efe6ff;
  --qm-text-soft: #cdb8f0;
  --qm-muted: #9f8ac0;
  --qm-text-dim: #b8a5d5;
  --qm-accent: #9370db;
  --qm-accent-2: #ff8fb5;
  --qm-accent-line: rgba(147, 112, 219, .6);
  --qm-on-accent: #ffffff;
  --qm-gold: #e8b84a;
  --qm-gold-border: rgba(232, 184, 74, .4);
  --qm-warn: #ffb03c;
  --qm-danger: #ff6060;
  --qm-card-bg: rgba(255, 255, 255, .05);
  --qm-card-bg-soft: rgba(255, 255, 255, .04);
  --qm-card-border: rgba(147, 112, 219, .28);
  --qm-line: rgba(147, 112, 219, .18);
  --qm-line-soft: rgba(147, 112, 219, .12);
  --qm-chip-bg: rgba(147, 112, 219, .16);
  --qm-btn-bg: rgba(255, 255, 255, .08);
  --qm-btn-border: rgba(147, 112, 219, .38);
  --qm-warn-bg: rgba(255, 176, 60, .12);
  --qm-warn-border: rgba(255, 176, 60, .3);
  --qm-danger-bg: rgba(255, 96, 96, .12);
  --qm-danger-border: rgba(255, 96, 96, .32);
  --qm-json-bg: rgba(10, 5, 25, .35);
  --qm-shadow-accent: rgba(147, 112, 219, .38);
  --qm-radius: 20rpx;
  --qm-radius-sm: 14rpx;
}

page {
  background: linear-gradient(160deg, var(--qm-bg-start) 0%, var(--qm-bg-mid) 40%, var(--qm-bg-end) 100%);
  min-height: 100%;
  color: var(--qm-text);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view, text, scroll-view, button, input, textarea {
  box-sizing: border-box;
}

/* ---------- 通用卡片 / 按钮 ---------- */
.qm-card {
  background: var(--qm-card-bg);
  border: 1rpx solid var(--qm-card-border);
  border-radius: var(--qm-radius);
  padding: 20rpx 22rpx;
}

.qm-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 38rpx;
  font-size: 28rpx;
  color: var(--qm-text-strong);
  background: var(--qm-btn-bg);
  border: 1rpx solid var(--qm-btn-border);
}

.qm-btn-primary {
  color: var(--qm-on-accent);
  background: linear-gradient(135deg, var(--qm-accent), var(--qm-accent-2));
  border: none;
  box-shadow: 0 8rpx 24rpx var(--qm-shadow-accent);
}

.qm-btn-ghost {
  color: var(--qm-text-dim);
  background: transparent;
  border: 1rpx solid var(--qm-btn-border);
}

.qm-muted { color: var(--qm-muted); }
.qm-gold { color: var(--qm-gold); }
.qm-danger { color: var(--qm-accent-2); }

/* ---------- 全屏页面形态（弹层统一容器） ---------- */
/* 左返回 + 居中标题 + 无 ✕；铺满视口、无遮罩留白、无圆角卡片感 */
.fs-page {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: linear-gradient(160deg, var(--qm-bg-start) 0%, var(--qm-bg-mid) 40%, var(--qm-bg-end) 100%);
}

.fs-header {
  position: relative;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  /* 透明底：与首页标题栏一致，只留文字与返回按钮；透明边框保留原高度 */
  background: transparent;
  border-bottom: 2rpx solid transparent;
}

.fs-back {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, .1);
}

.fs-back-ico {
  margin-top: -6rpx;
  font-size: 44rpx;
  line-height: 1;
  color: #e0d0f0;
}

.fs-back-press { background: rgba(255, 255, 255, .2); }

.fs-title {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  max-width: 62%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #e0d0f0;
}

.fs-body {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.fs-foot {
  flex: 0 0 auto;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(180, 140, 220, .15);
}

/* ---------- 弹层（页面内自绘遮罩，替代网页的 iframe/遮罩 div） ---------- */
.qm-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(10, 5, 25, .82);
  z-index: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qm-dialog {
  width: 620rpx;
  max-height: 76vh;
  overflow-y: auto;
  background: linear-gradient(170deg, #2a1a48, #1e1033);
  border: 1rpx solid rgba(147, 112, 219, .4);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, .6);
}

.qm-dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #e8dff5;
  margin-bottom: 18rpx;
}

.qm-field {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.qm-field-label {
  width: 120rpx;
  flex: 0 0 auto;
  color: #b8a5d5;
  font-size: 26rpx;
}

.qm-input {
  flex: 1;
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, .06);
  border: 1rpx solid rgba(147, 112, 219, .3);
  color: #e8e0f0;
  font-size: 28rpx;
}

/* ---------- DF-61/DF-85：档案栏（奇门 / 八字共用一套，全仓仅此一份定义） ---------- */
/* 规则一律限定在 .arch-bar 作用域内：chat 页的「我的档案」列表也用到 .arch-sub/.arch-add，
   限定后不会渗入 chat（页级 chat.wxss 亦保持不变），类名与数值仍与奇门原值逐项一致。 */
.arch-bar { margin-bottom: 18rpx; display: flex; align-items: center; }
.arch-bar .arch-scroll { white-space: nowrap; flex: 1 1 auto; min-width: 0; }
.arch-bar .arch-chip {
  display: inline-block;
  vertical-align: top;
  min-width: 150rpx;
  padding: 10rpx 18rpx;
  margin-right: 12rpx;
  border-radius: 14rpx;
  background: rgba(147, 112, 219, .12);
  border: 1rpx solid rgba(147, 112, 219, .3);
}
.arch-bar .arch-chip.on { background: rgba(232, 184, 74, .18); border-color: rgba(232, 184, 74, .7); }
.arch-bar .arch-nick { font-size: 24rpx; color: #e8dff5; }
.arch-bar .arch-chip.on .arch-nick { color: #ffd979; }
.arch-bar .arch-sub { font-size: 20rpx; color: #9f8ac0; margin-top: 2rpx; }
.arch-bar .arch-add {
  flex: 0 0 auto;
  margin-left: 12rpx;
  height: 56rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  border-radius: 14rpx;
  font-size: 22rpx;
  color: #cbb6ee;
  background: rgba(147, 112, 219, .06);
  border: 1rpx dashed rgba(147, 112, 219, .5);
}
.arch-bar .arch-empty { display: flex; justify-content: center; flex: 1; }
.arch-bar .arch-empty .qm-btn { width: 240rpx; }

/* ---------- 详情页固定浮底工具条（八字 / 奇门 / 梅花 / 证券详情共用一套） ---------- */
/* 贴底不随内容滚动；底部安全区由 env(safe-area-inset-bottom) 兜底。
   对应页面需在 .page 上预留 padding-bottom，避免滚到底时末行被遮住。 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(24, 13, 44, .96);
  border-top: 1rpx solid rgba(180, 140, 220, .18);
  box-shadow: 0 -10rpx 30rpx rgba(0, 0, 0, .38);
}
.bottom-bar .qm-btn { flex: 1; margin-right: 16rpx; }
.bottom-bar .qm-btn:last-child { margin-right: 0; }
